---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

export function getStaticPaths() {
  const pages = [
    { slug: "home", label: "Homepage", previewPath: "/" },
    { slug: "about", label: "About", previewPath: "/about" },
    { slug: "students", label: "Students", previewPath: "/students" },
    { slug: "mentors", label: "Mentors", previewPath: "/mentors" },
    { slug: "resources", label: "Resources", previewPath: "/resources" },
    { slug: "blog", label: "Blog", previewPath: "/blog" },
    { slug: "webinars", label: "Webinars", previewPath: "/webinars" },
    { slug: "workshops", label: "Workshops", previewPath: "/workshops" },
  ];

  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { pageMeta: page },
  }));
}

const { pageMeta } = Astro.props;
const page = await getEntry("pages", pageMeta.slug);
const data = page?.data ?? {};

const hero = data.hero ?? {};
const dashboard = data.dashboard ?? {};
const sections = data.sections ?? {};
const cards = data.cards ?? {};
const buttons = data.buttons ?? {};

const initialData = JSON.stringify({
  title: data.title ?? pageMeta.label,
  hero,
  dashboard,
  sections,
  cards,
  buttons,
});

const sectionMeta = [
  { key: "problem", label: "Problem cards", tone: "cream", grid: "g3" },
  { key: "method", label: "Method cards", tone: "light", grid: "g4" },
  { key: "curriculum", label: "Curriculum cards", tone: "navy", grid: "g4" },
  { key: "pathways", label: "Pathway cards", tone: "cream", grid: "g2" },
  { key: "cta", label: "Final call to action", tone: "light", grid: "" },
];
---

<BaseLayout title={`Edit ${pageMeta.label} | LawBridge Admin`}>
  <div class="visual-editor-bar">
    <div>
      <strong>Editing: {pageMeta.label}</strong>
      <span>Click directly on highlighted content, make changes, then publish.</span>
    </div>

    <div class="visual-editor-actions">
      <a href="/admin" class="editor-secondary">Back to Admin</a>
      <a href={pageMeta.previewPath} class="editor-secondary" target="_blank">Preview Live Page</a>
      <button id="publish-page" class="editor-primary" type="button">Publish Changes</button>
    </div>
  </div>

  <div id="editor-status" class="visual-editor-status">
    Select any highlighted text area and edit directly on the page.
  </div>

  <div id="deployment-panel" class="deployment-panel" hidden>
    <p class="deployment-label">Publishing status</p>
    <ol>
      <li id="deploy-step-save">Waiting for changes</li>
      <li id="deploy-step-github">GitHub update pending</li>
      <li id="deploy-step-netlify">Netlify deployment pending</li>
    </ol>
  </div>

  <section class="hero visual-edit-section">
    <div class="container hero-grid" data-hero-grid>
      <div>
        <p class="eyebrow editable-text" contenteditable="true" data-field="hero.eyebrow">
          {hero.eyebrow}
        </p>

        <h1 class="editable-text" contenteditable="true" data-field="hero.heading">
          {hero.heading}
        </h1>

        <p class="hero-lead editable-text" contenteditable="true" data-field="hero.description">
          {hero.description}
        </p>

        <div class="hero-actions">
          {hero.primaryButtonText && (
            <span class="btn primary editable-text" contenteditable="true" data-field="hero.primaryButtonText">
              {hero.primaryButtonText}
            </span>
          )}

          {hero.secondaryButtonText && (
            <span class="btn secondary editable-text" contenteditable="true" data-field="hero.secondaryButtonText">
              {hero.secondaryButtonText}
            </span>
          )}

          {hero.tertiaryButtonText && (
            <span class="btn ghost editable-text" contenteditable="true" data-field="hero.tertiaryButtonText">
              {hero.tertiaryButtonText}
            </span>
          )}
        </div>
      </div>

      {dashboard?.heading ? (
        <div class="dashboard-card visual-edit-card" data-dashboard-card>
          <div class="visual-card-tools dashboard-tools">
            <span>Hero dashboard card</span>
            <button type="button" data-remove-dashboard-card>
              Remove dashboard card
            </button>
          </div>

          <span class="pill editable-text" contenteditable="true" data-field="dashboard.label">
            {dashboard.label}
          </span>

          <h2 class="editable-text" contenteditable="true" data-field="dashboard.heading">
            {dashboard.heading}
          </h2>

          <p class="editable-text" contenteditable="true" data-field="dashboard.description">
            {dashboard.description}
          </p>

          <div class="visual-card-tools dashboard-tools">
            <span>Dashboard bullet points</span>
            <button type="button" data-add-dashboard-item>
              Add bullet
            </button>
          </div>

          <div class="dashboard-list visual-dashboard-list" data-dashboard-list>
            {(dashboard.items ?? []).map((item, index) => (
              <span class="visual-dashboard-item">
                <span class="editable-text dashboard-item-text" contenteditable="true" data-dashboard-item={index}>
                  {item}
                </span>
                <button type="button" data-remove-dashboard-item>
                  Remove
                </button>
              </span>
            ))}
          </div>
        </div>
      ) : (
        <div class="dashboard-card visual-edit-card dashboard-placeholder" data-dashboard-placeholder>
          <span class="pill">Optional hero card</span>
          <h2>No dashboard card on this page</h2>
          <p>
            Add a hero dashboard card if this page needs a supporting card beside the main heading.
          </p>

          <button type="button" class="editor-primary dashboard-add-button" data-add-dashboard-card>
            Add dashboard card
          </button>
        </div>
      )}
    </div>
  </section>

  {sectionMeta.map((section) => (
    <section class={`section ${section.tone} visual-edit-section`}>
      <div class="container">
        <p class="eyebrow editable-text" contenteditable="true" data-field={`sections.${section.key}.eyebrow`}>
          {sections[section.key]?.eyebrow}
        </p>

        <h2 class="editable-text" contenteditable="true" data-field={`sections.${section.key}.heading`}>
          {sections[section.key]?.heading}
        </h2>

        <p class="section-intro editable-text" contenteditable="true" data-field={`sections.${section.key}.description`}>
          {sections[section.key]?.description}
        </p>

        {section.key !== "cta" && (
          <>
            <div class="visual-card-tools">
              <span>{section.label}</span>
              <button type="button" data-add-card={section.key}>
                Add card
              </button>
            </div>

            <div class={`grid ${section.grid}`} data-card-list={section.key}>
              {(cards[section.key] ?? []).map((card, index) => (
                <article
                  class={section.key === "curriculum" ? "curric visual-edit-card" : "card visual-edit-card"}
                  data-card-group={section.key}
                  data-card-index={index}
                >
                  <button type="button" class="remove-card-button" data-remove-card>
                    Remove
                  </button>

                  <h3 class="editable-text" contenteditable="true" data-card-field="title">
                    {card.title}
                  </h3>

                  <p class="editable-text" contenteditable="true" data-card-field="description">
                    {card.description}
                  </p>

                  {section.key === "pathways" && (
                    <div class="visual-card-link-fields">
                      <span class="btn secondary editable-text" contenteditable="true" data-card-field="buttonText">
                        {card.buttonText}
                      </span>

                      <label>
                        Button link
                        <input data-card-field="buttonLink" value={card.buttonLink ?? ""} />
                      </label>
                    </div>
                  )}
                </article>
              ))}
            </div>
          </>
        )}

        {section.key === "cta" && (
          <div class="hero-actions">
            {buttons.cta?.primaryText && (
              <span class="btn primary editable-text" contenteditable="true" data-field="buttons.cta.primaryText">
                {buttons.cta.primaryText}
              </span>
            )}

            {buttons.cta?.secondaryText && (
              <span class="btn secondary editable-text" contenteditable="true" data-field="buttons.cta.secondaryText">
                {buttons.cta.secondaryText}
              </span>
            )}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section cream">
    <div class="container visual-link-panel">
      <p class="eyebrow">Button links</p>
      <h2>Update button destinations</h2>
      <p class="section-intro">
        Edit page text directly above. Use these fields only when a button needs to link somewhere different.
      </p>

      <div class="visual-link-grid">
        <label>
          Primary hero button link
          <input data-value-field="hero.primaryButtonLink" value={hero.primaryButtonLink ?? ""} />
        </label>

        <label>
          Secondary hero button link
          <input data-value-field="hero.secondaryButtonLink" value={hero.secondaryButtonLink ?? ""} />
        </label>

        <label>
          Third hero button link
          <input data-value-field="hero.tertiaryButtonLink" value={hero.tertiaryButtonLink ?? ""} />
        </label>

        <label>
          Final primary button link
          <input data-value-field="buttons.cta.primaryLink" value={buttons.cta?.primaryLink ?? ""} />
        </label>

        <label>
          Final secondary button link
          <input data-value-field="buttons.cta.secondaryLink" value={buttons.cta?.secondaryLink ?? ""} />
        </label>
      </div>
    </div>
  </section>

  <div id="publish-modal" class="publish-modal" hidden>
    <div class="publish-modal-card">
      <p class="eyebrow">Published</p>
      <h2>Changes saved successfully</h2>
      <p>
        Your content has been sent to GitHub. Netlify will now rebuild the website and publish the updated page.
      </p>

      <div class="publish-checklist">
        <div>
          <strong>1. Content saved</strong>
          <span>The page content file has been updated.</span>
        </div>

        <div>
          <strong>2. Deployment triggered</strong>
          <span>Netlify should start a fresh deployment automatically.</span>
        </div>

        <div>
          <strong>3. Review live page</strong>
          <span>Open the live page once the Netlify deploy has completed.</span>
        </div>
      </div>

      <div class="publish-modal-actions">
        <a href="/admin" class="editor-secondary">Back to Admin</a>
        <a href={pageMeta.previewPath} class="editor-primary" target="_blank">Open Live Page</a>
        <button id="close-publish-modal" type="button" class="editor-secondary">Continue Editing</button>
      </div>
    </div>
  </div>

  <style is:inline>
    .visual-editor-bar {
      position: sticky;
      top: 0;
      z-index: 9999;
      padding: 1rem 1.5rem;
      background: rgba(6, 27, 49, 0.96);
      color: #ffffff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      box-shadow: 0 20px 55px rgba(6, 27, 49, 0.22);
      backdrop-filter: blur(16px);
    }

    .visual-editor-bar strong {
      display: block;
      font-size: 1rem;
    }

    .visual-editor-bar span {
      display: block;
      margin-top: 0.2rem;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.86rem;
    }

    .visual-editor-actions {
      display: flex;
      gap: 0.7rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .editor-primary,
    .editor-secondary {
      border: 0;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      font-weight: 900;
      text-decoration: none;
      cursor: pointer;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .editor-primary {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
    }

    .editor-secondary {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .visual-editor-status {
      position: fixed;
      right: 1.2rem;
      bottom: 1.2rem;
      z-index: 9999;
      max-width: 380px;
      padding: 0.85rem 1rem;
      border-radius: 18px;
      background: #061b31;
      color: #ffffff;
      box-shadow: 0 18px 55px rgba(6, 27, 49, 0.25);
      font-weight: 800;
      font-size: 0.9rem;
    }

    .deployment-panel {
      position: fixed;
      left: 1.2rem;
      bottom: 1.2rem;
      z-index: 9999;
      width: min(360px, calc(100vw - 2.4rem));
      padding: 1rem;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 55px rgba(6, 27, 49, 0.16);
      color: #061b31;
    }

    .deployment-panel[hidden] {
      display: none;
    }

    .deployment-label {
      margin: 0 0 0.6rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.72rem;
    }

    .deployment-panel ol {
      margin: 0;
      padding-left: 1.1rem;
      display: grid;
      gap: 0.35rem;
      color: #334155;
      font-weight: 800;
      font-size: 0.88rem;
    }

    .deployment-panel li.complete {
      color: #0f766e;
    }

    .deployment-panel li.active {
      color: #b37b32;
    }

    .visual-edit-section {
      position: relative;
    }

    .editable-text {
      cursor: text;
      outline: 2px dashed transparent;
      outline-offset: 6px;
      border-radius: 10px;
      transition: outline-color 0.2s ease, background-color 0.2s ease;
    }

    .editable-text:hover {
      outline-color: rgba(211, 155, 69, 0.75);
      background: rgba(231, 182, 95, 0.08);
    }

    .editable-text:focus {
      outline-color: #d39b45;
      background: rgba(231, 182, 95, 0.16);
    }

    .visual-edit-card {
      position: relative;
    }

    .visual-card-tools {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 1.4rem 0 1rem;
      padding: 0.9rem 1rem;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(201, 150, 82, 0.26);
      box-shadow: 0 14px 38px rgba(6, 27, 49, 0.08);
    }

    .dashboard-tools {
      margin-top: 1rem;
      margin-bottom: 1rem;
      background: rgba(6, 27, 49, 0.04);
      box-shadow: none;
    }

    .visual-card-tools span {
      color: #061b31;
      font-weight: 900;
    }

    .visual-card-tools button,
    .remove-card-button,
    .visual-dashboard-item button {
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 900;
      font-size: 0.88rem;
    }

    .visual-card-tools button {
      padding: 0.68rem 1rem;
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
    }

    .remove-card-button {
      position: absolute;
      right: 0.9rem;
      top: 0.9rem;
      padding: 0.48rem 0.78rem;
      background: rgba(6, 27, 49, 0.08);
      color: #061b31;
      border: 1px solid rgba(6, 27, 49, 0.12);
    }

    .remove-card-button:hover,
    .visual-dashboard-item button:hover {
      background: rgba(211, 155, 69, 0.16);
    }

    .dashboard-add-button {
      margin-top: 1rem;
      width: fit-content;
    }

    .dashboard-placeholder {
      border: 2px dashed rgba(211, 155, 69, 0.36);
      background: rgba(255, 255, 255, 0.74);
    }

    .visual-dashboard-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      margin-top: 1rem;
    }

    .visual-dashboard-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      padding: 0.75rem 0.75rem;
      border-radius: 999px;
      background: rgba(6, 27, 49, 0.04);
      border: 1px solid rgba(201, 150, 82, 0.18);
    }

    .dashboard-item-text {
      flex: 1;
      min-width: 0;
      font-weight: 900;
      color: #061b31;
    }

    .visual-dashboard-item button {
      flex: 0 0 auto;
      padding: 0.35rem 0.65rem;
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(6, 27, 49, 0.12);
      font-size: 0.74rem;
    }

    .visual-card-link-fields {
      display: grid;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .visual-card-link-fields label,
    .visual-link-panel label {
      display: grid;
      gap: 0.45rem;
      color: #061b31;
      font-weight: 900;
    }

    .visual-card-link-fields input,
    .visual-link-panel input {
      width: 100%;
      border: 1px solid rgba(201, 150, 82, 0.34);
      border-radius: 14px;
      padding: 0.85rem 1rem;
      font: inherit;
      color: #061b31;
      background: #ffffff;
    }

    .visual-link-panel {
      padding: 2rem;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 24px 70px rgba(6, 27, 49, 0.1);
    }

    .visual-link-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .publish-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: grid;
      place-items: center;
      padding: 1.5rem;
      background: rgba(6, 27, 49, 0.55);
      backdrop-filter: blur(10px);
    }

    .publish-modal[hidden] {
      display: none;
    }

    .publish-modal-card {
      width: min(680px, 100%);
      padding: 2rem;
      border-radius: 28px;
      background: #fbf7ef;
      border: 1px solid rgba(201, 150, 82, 0.32);
      box-shadow: 0 30px 90px rgba(6, 27, 49, 0.25);
      color: #061b31;
    }

    .publish-modal-card h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 4vw, 3rem);
      color: #061b31;
    }

    .publish-modal-card p:not(.eyebrow) {
      color: #334155;
      line-height: 1.65;
    }

    .publish-checklist {
      display: grid;
      gap: 0.8rem;
      margin-top: 1.25rem;
    }

    .publish-checklist div {
      padding: 1rem;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(201, 150, 82, 0.22);
    }

    .publish-checklist strong {
      display: block;
      color: #061b31;
      margin-bottom: 0.25rem;
    }

    .publish-checklist span {
      color: #334155;
      font-size: 0.94rem;
    }

    .publish-modal-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 1.4rem;
    }

    .publish-modal-actions .editor-secondary {
      background: #061b31;
      color: #ffffff;
    }

    @media (max-width: 860px) {
      .visual-editor-bar {
        align-items: flex-start;
        flex-direction: column;
      }

      .visual-link-grid,
      .visual-dashboard-list {
        grid-template-columns: 1fr;
      }

      .visual-editor-status {
        left: 1rem;
        right: 1rem;
        bottom: 1rem;
      }

      .deployment-panel {
        left: 1rem;
        right: 1rem;
        bottom: 5.5rem;
        width: auto;
      }

      .visual-card-tools {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>

  <script define:vars={{ initialData, pageSlug: pageMeta.slug }}>
    const state = JSON.parse(initialData);
    const statusBox = document.getElementById("editor-status");
    const publishButton = document.getElementById("publish-page");
    const publishModal = document.getElementById("publish-modal");
    const closePublishModal = document.getElementById("close-publish-modal");
    const deploymentPanel = document.getElementById("deployment-panel");
    const deployStepSave = document.getElementById("deploy-step-save");
    const deployStepGithub = document.getElementById("deploy-step-github");
    const deployStepNetlify = document.getElementById("deploy-step-netlify");

    let hasUnsavedChanges = false;
    let isPublishing = false;

    function setStatus(message) {
      if (statusBox) {
        statusBox.textContent = message;
      }
    }

    function setDeployStep(element, status, text) {
      if (!element) {
        return;
      }

      element.classList.remove("active", "complete");

      if (status) {
        element.classList.add(status);
      }

      if (text) {
        element.textContent = text;
      }
    }

    function showDeploymentPanel() {
      if (deploymentPanel) {
        deploymentPanel.hidden = false;
      }
    }

    function markUnsaved(message = "Unsaved changes. Press Publish Changes to update the website.") {
      hasUnsavedChanges = true;
      isPublishing = false;

      if (publishButton) {
        publishButton.disabled = false;
        publishButton.textContent = "Publish Changes";
      }

      setStatus(message);
      showDeploymentPanel();
      setDeployStep(deployStepSave, "active", "Changes waiting to be published");
      setDeployStep(deployStepGithub, "", "GitHub update pending");
      setDeployStep(deployStepNetlify, "", "Netlify deployment pending");
    }

    function markSaved() {
      hasUnsavedChanges = false;
      isPublishing = false;
      setStatus("Published. Netlify is redeploying the website.");

      if (publishButton) {
        publishButton.disabled = false;
        publishButton.textContent = "Publish Again";
      }

      showDeploymentPanel();
      setDeployStep(deployStepSave, "complete", "Changes saved");
      setDeployStep(deployStepGithub, "complete", "GitHub content file updated");
      setDeployStep(deployStepNetlify, "active", "Netlify deployment should now be running");
    }

    window.addEventListener("beforeunload", (event) => {
      if (!hasUnsavedChanges || isPublishing) {
        return;
      }

      event.preventDefault();
      event.returnValue = "";
    });

    document.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (!hasUnsavedChanges || isPublishing) {
          return;
        }

        const shouldLeave = window.confirm(
          "You have unpublished changes. Leave this page without publishing?"
        );

        if (!shouldLeave) {
          event.preventDefault();
        }
      });
    });

    function setPath(target, path, value) {
      const parts = path.split(".");
      let current = target;

      parts.forEach((part, index) => {
        if (index === parts.length - 1) {
          current[part] = value;
          return;
        }

        if (!current[part] || typeof current[part] !== "object") {
          current[part] = {};
        }

        current = current[part];
      });
    }

    function getText(element) {
      return (element?.innerText || "").replace(/\s+\n/g, "\n").trim();
    }

    function attachEditableListeners(root = document) {
      root.querySelectorAll("[contenteditable='true']").forEach((element) => {
        if (element.dataset.editorListenerAttached === "true") {
          return;
        }

        element.dataset.editorListenerAttached = "true";

        element.addEventListener("focus", () => {
          setStatus("Editing selected text. Press Publish Changes when finished.");
        });

        element.addEventListener("input", () => {
          markUnsaved();
        });
      });

      root.querySelectorAll("input").forEach((input) => {
        if (input.dataset.editorListenerAttached === "true") {
          return;
        }

        input.dataset.editorListenerAttached = "true";

        input.addEventListener("input", () => {
          markUnsaved("Unsaved link changes. Press Publish Changes to update the website.");
        });
      });
    }

    function collectTextFields() {
      document.querySelectorAll("[data-field]").forEach((element) => {
        setPath(state, element.dataset.field, getText(element));
      });

      document.querySelectorAll("[data-value-field]").forEach((element) => {
        setPath(state, element.dataset.valueField, element.value.trim());
      });
    }

    function collectDashboardItems() {
      const dashboardCard = document.querySelector("[data-dashboard-card]");

      if (!dashboardCard) {
        state.dashboard = {};
        return;
      }

      const items = Array.from(dashboardCard.querySelectorAll("[data-dashboard-item]"))
        .map((element) => getText(element))
        .filter(Boolean);

      if (!state.dashboard) {
        state.dashboard = {};
      }

      state.dashboard.items = items;
    }

    function collectCards() {
      state.cards = state.cards || {};

      ["problem", "method", "curriculum", "pathways"].forEach((group) => {
        const cardElements = Array.from(document.querySelectorAll(`[data-card-group="${group}"]`));

        state.cards[group] = cardElements.map((cardElement) => {
          const card = {
            title: getText(cardElement.querySelector('[data-card-field="title"]')),
            description: getText(cardElement.querySelector('[data-card-field="description"]')),
          };

          if (group === "pathways") {
            card.buttonText = getText(cardElement.querySelector('[data-card-field="buttonText"]'));
            card.buttonLink = cardElement.querySelector('[data-card-field="buttonLink"]')?.value.trim() || "";
          }

          return card;
        });
      });
    }

    function collectState() {
      collectTextFields();
      collectDashboardItems();
      collectCards();
      return state;
    }

    function renumberCards(group) {
      const cardElements = Array.from(document.querySelectorAll(`[data-card-group="${group}"]`));

      cardElements.forEach((cardElement, index) => {
        cardElement.dataset.cardIndex = index.toString();
      });
    }

    function renumberDashboardItems() {
      const items = Array.from(document.querySelectorAll("[data-dashboard-item]"));

      items.forEach((item, index) => {
        item.dataset.dashboardItem = index.toString();
      });
    }

    function createEditableText(tagName, className, fieldName, text) {
      const element = document.createElement(tagName);
      element.className = className;
      element.contentEditable = "true";
      element.dataset.cardField = fieldName;
      element.textContent = text;
      return element;
    }

    function createDashboardPlaceholder() {
      const placeholder = document.createElement("div");
      placeholder.className = "dashboard-card visual-edit-card dashboard-placeholder";
      placeholder.dataset.dashboardPlaceholder = "";

      placeholder.innerHTML = `
        <span class="pill">Optional hero card</span>
        <h2>No dashboard card on this page</h2>
        <p>Add a hero dashboard card if this page needs a supporting card beside the main heading.</p>
        <button type="button" class="editor-primary dashboard-add-button" data-add-dashboard-card>
          Add dashboard card
        </button>
      `;

      return placeholder;
    }

    function createDashboardItem(textValue = "New bullet point") {
      const list = document.querySelector("[data-dashboard-list]");

      if (!list) {
        return;
      }

      const wrapper = document.createElement("span");
      wrapper.className = "visual-dashboard-item";

      const text = document.createElement("span");
      text.className = "editable-text dashboard-item-text";
      text.contentEditable = "true";
      text.dataset.dashboardItem = "";
      text.textContent = textValue;

      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.dataset.removeDashboardItem = "";
      removeButton.textContent = "Remove";

      wrapper.appendChild(text);
      wrapper.appendChild(removeButton);
      list.appendChild(wrapper);

      renumberDashboardItems();
      attachEditableListeners(wrapper);
      markUnsaved("Dashboard bullet updated. Press Publish Changes to update the website.");
    }

    function createDashboardCard() {
      const heroGrid = document.querySelector("[data-hero-grid]");
      const placeholder = document.querySelector("[data-dashboard-placeholder]");

      if (!heroGrid) {
        return;
      }

      const card = document.createElement("div");
      card.className = "dashboard-card visual-edit-card";
      card.dataset.dashboardCard = "";

      card.innerHTML = `
        <div class="visual-card-tools dashboard-tools">
          <span>Hero dashboard card</span>
          <button type="button" data-remove-dashboard-card>
            Remove dashboard card
          </button>
        </div>

        <span class="pill editable-text" contenteditable="true" data-field="dashboard.label">
          LawBridge Platform
        </span>

        <h2 class="editable-text" contenteditable="true" data-field="dashboard.heading">
          Practical legal development
        </h2>

        <p class="editable-text" contenteditable="true" data-field="dashboard.description">
          Add a short supporting message for this page.
        </p>

        <div class="visual-card-tools dashboard-tools">
          <span>Dashboard bullet points</span>
          <button type="button" data-add-dashboard-item>
            Add bullet
          </button>
        </div>

        <div class="dashboard-list visual-dashboard-list" data-dashboard-list></div>
      `;

      if (placeholder) {
        placeholder.replaceWith(card);
      } else {
        heroGrid.appendChild(card);
      }

      attachEditableListeners(card);
      createDashboardItem("First bullet point");
      createDashboardItem("Second bullet point");
      markUnsaved("Dashboard card added. Press Publish Changes to update the website.");
    }

    function removeDashboardCard() {
      const dashboardCard = document.querySelector("[data-dashboard-card]");

      if (!dashboardCard) {
        return;
      }

      dashboardCard.replaceWith(createDashboardPlaceholder());
      state.dashboard = {};
      markUnsaved("Dashboard card removed. Press Publish Changes to update the website.");
    }

    function createCard(group) {
      const list = document.querySelector(`[data-card-list="${group}"]`);

      if (!list) {
        return;
      }

      const article = document.createElement("article");
      article.className = group === "curriculum" ? "curric visual-edit-card" : "card visual-edit-card";
      article.dataset.cardGroup = group;

      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className = "remove-card-button";
      removeButton.dataset.removeCard = "";
      removeButton.textContent = "Remove";

      const title = createEditableText("h3", "editable-text", "title", "New card title");
      const description = createEditableText(
        "p",
        "editable-text",
        "description",
        "Add a short description for this card."
      );

      article.appendChild(removeButton);
      article.appendChild(title);
      article.appendChild(description);

      if (group === "pathways") {
        const linkFields = document.createElement("div");
        linkFields.className = "visual-card-link-fields";

        const buttonText = createEditableText(
          "span",
          "btn secondary editable-text",
          "buttonText",
          "Button text"
        );

        const label = document.createElement("label");
        label.textContent = "Button link";

        const input = document.createElement("input");
        input.dataset.cardField = "buttonLink";
        input.value = "/contact";

        label.appendChild(input);
        linkFields.appendChild(buttonText);
        linkFields.appendChild(label);
        article.appendChild(linkFields);
      }

      list.appendChild(article);
      renumberCards(group);
      attachEditableListeners(article);
      markUnsaved("New card added. Press Publish Changes to update the website.");
    }

    document.addEventListener("click", (event) => {
      const addCardButton = event.target.closest("[data-add-card]");

      if (addCardButton) {
        createCard(addCardButton.dataset.addCard);
        return;
      }

      const addDashboardButton = event.target.closest("[data-add-dashboard-card]");

      if (addDashboardButton) {
        createDashboardCard();
        return;
      }

      const addDashboardItemButton = event.target.closest("[data-add-dashboard-item]");

      if (addDashboardItemButton) {
        createDashboardItem();
        return;
      }

      const removeDashboardCardButton = event.target.closest("[data-remove-dashboard-card]");

      if (removeDashboardCardButton) {
        const confirmed = window.confirm("Remove this hero dashboard card from the page?");

        if (confirmed) {
          removeDashboardCard();
        }

        return;
      }

      const removeCardButton = event.target.closest("[data-remove-card]");

      if (removeCardButton) {
        const card = removeCardButton.closest("[data-card-group]");
        const group = card?.dataset.cardGroup;

        if (!card || !group) {
          return;
        }

        card.remove();
        renumberCards(group);
        markUnsaved("Card removed. Press Publish Changes to update the website.");
        return;
      }

      const removeDashboardItemButton = event.target.closest("[data-remove-dashboard-item]");

      if (removeDashboardItemButton) {
        const item = removeDashboardItemButton.closest(".visual-dashboard-item");

        if (!item) {
          return;
        }

        item.remove();
        renumberDashboardItems();
        markUnsaved("Dashboard bullet removed. Press Publish Changes to update the website.");
      }
    });

    attachEditableListeners();

    if (closePublishModal && publishModal) {
      closePublishModal.addEventListener("click", () => {
        publishModal.hidden = true;
      });
    }

    if (publishButton) {
      publishButton.addEventListener("click", async () => {
        try {
          if (!window.netlifyIdentity) {
            setStatus("Netlify Identity is not loaded.");
            return;
          }

          const user = window.netlifyIdentity.currentUser();

          if (!user) {
            setStatus("Please log in before publishing.");
            window.netlifyIdentity.open("login");
            return;
          }

          isPublishing = true;
          publishButton.disabled = true;
          publishButton.textContent = "Publishing...";
          setStatus("Publishing changes...");
          showDeploymentPanel();
          setDeployStep(deployStepSave, "active", "Preparing changes");
          setDeployStep(deployStepGithub, "", "GitHub update pending");
          setDeployStep(deployStepNetlify, "", "Netlify deployment pending");

          const token = await user.jwt();
          const updatedData = collectState();

          setDeployStep(deployStepSave, "complete", "Changes prepared");
          setDeployStep(deployStepGithub, "active", "Updating GitHub content file");

          const response = await fetch("/.netlify/functions/update-page-content", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              page: pageSlug,
              data: updatedData,
            }),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || "Could not publish changes.");
          }

          markSaved();

          if (publishModal) {
            publishModal.hidden = false;
          }
        } catch (error) {
          isPublishing = false;
          setStatus(error.message || "Something went wrong.");
          setDeployStep(deployStepGithub, "", "GitHub update failed");
          setDeployStep(deployStepNetlify, "", "Netlify deployment not started");

          if (publishButton) {
            publishButton.disabled = false;
            publishButton.textContent = "Publish Changes";
          }
        }
      });
    }
  </script>
</BaseLayout>
