---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const skillAreas = [
  "Advocacy and Oral Presentation",
  "Attendance Notes and Legal Analysis",
  "Case and Matter Analysis",
  "Client Interviewing",
  "Legal Drafting",
  "Legal Research",
  "Legal Writing",
];

const difficulties = [
  "Foundation",
  "Foundation to Guided Practice",
  "Foundation to Intermediate",
  "Intermediate",
  "Intermediate to Advanced",
  "Advanced",
];

const categories = [
  "Practical Skills",
  "Student Pack",
  "Tutor Guide",
  "Workshop Resource",
];
---

<BaseLayout title="Add Resource Simulation | LawBridge Admin">
  <section class="studio-shell">
    <div class="container">
      <div class="studio-topbar">
        <a href="/admin" class="studio-back">← Back to Admin</a>
        <a href="/resources" class="studio-preview" target="_blank">Preview Resources Page</a>
      </div>

      <header class="studio-hero">
        <div>
          <p class="studio-eyebrow">LawBridge Content Studio</p>
          <h1>Add a practical skills resource.</h1>
          <p>
            Upload a Student Pack and optional Tutor Guide. The resource will appear on the Resources page in the practical simulation format.
          </p>
        </div>

        <aside class="studio-guide">
          <h2>Resource format</h2>
          <ol>
            <li>Add the simulation code, skill and scenario.</li>
            <li>Upload the Student Pack.</li>
            <li>Optionally upload a Tutor Guide.</li>
            <li>Publish and wait for Netlify to redeploy.</li>
          </ol>
        </aside>
      </header>

      <div class="studio-layout">
        <form id="resource-form" class="studio-form">
          <div class="form-card">
            <p class="studio-eyebrow">Simulation details</p>

            <div class="form-grid">
              <label>
                Resource code
                <input
                  id="resource-code"
                  name="code"
                  type="text"
                  placeholder="Example: CI-01, AO-02, LD-01"
                  required
                />
              </label>

              <label>
                Category
                <select id="resource-category" name="category">
                  {categories.map((category) => (
                    <option value={category}>{category}</option>
                  ))}
                </select>
              </label>
            </div>

            <label>
              Display title
              <input
                id="resource-title"
                name="title"
                type="text"
                placeholder="Example: The Startup Founder With a Failed Software Launch"
                required
              />
            </label>

            <label>
              Scenario title
              <input
                id="resource-scenario"
                name="scenario"
                type="text"
                placeholder="Example: Initial client interview in a technology services dispute"
                required
              />
            </label>

            <div class="form-grid">
              <label>
                Skill area
                <select id="resource-skill" name="skill">
                  {skillAreas.map((skill) => (
                    <option value={skill}>{skill}</option>
                  ))}
                </select>
              </label>

              <label>
                Difficulty
                <select id="resource-difficulty" name="difficulty">
                  {difficulties.map((difficulty) => (
                    <option value={difficulty}>{difficulty}</option>
                  ))}
                </select>
              </label>
            </div>

            <label>
              Short card summary
              <textarea
                id="resource-summary"
                name="summary"
                rows="5"
                placeholder="Briefly explain what this simulation helps students practise. If left blank, LawBridge will try to create a summary from the Student Pack."
              ></textarea>
            </label>
          </div>

          <div class="form-card">
            <p class="studio-eyebrow">Student Pack</p>

            <label class="upload-box" for="student-file">
              <span>Upload Student Pack</span>
              <strong id="student-file-name">No Student Pack selected</strong>
              <small>
                Required. Upload a .docx or .pdf file. This becomes the “View Student Pack” button.
              </small>
            </label>

            <input
              id="student-file"
              name="studentFile"
              type="file"
              accept=".docx,.pdf,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              required
              hidden
            />
          </div>

          <div class="form-card">
            <p class="studio-eyebrow">Tutor Guide</p>

            <label class="upload-box tutor-upload" for="tutor-file">
              <span>Upload Tutor Guide</span>
              <strong id="tutor-file-name">No Tutor Guide selected</strong>
              <small>
                Optional. Upload a .docx or .pdf file. This becomes the “View Tutor Guide” button.
              </small>
            </label>

            <input
              id="tutor-file"
              name="tutorFile"
              type="file"
              accept=".docx,.pdf,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              hidden
            />

            <button id="clear-tutor-file" type="button" class="studio-button secondary clear-file-button">
              Remove Tutor Guide
            </button>
          </div>

          <div class="form-actions">
            <button id="publish-resource" type="submit" class="studio-button primary">
              Publish Resource
            </button>

            <button id="reset-form" type="button" class="studio-button secondary">
              Clear Form
            </button>
          </div>
        </form>

        <aside class="studio-preview-panel">
          <p class="studio-eyebrow">Resource preview</p>

          <div class="resource-preview-card">
            <div class="preview-card-top">
              <span id="preview-code">CODE</span>
              <span id="preview-difficulty">Intermediate</span>
            </div>

            <p id="preview-skill" class="preview-skill">
              Advocacy and Oral Presentation
            </p>

            <h2 id="preview-title">Resource title will appear here</h2>

            <p id="preview-scenario">
              Scenario title will appear here.
            </p>

            <p id="preview-summary">
              Add a summary to preview how the resource card will look on the Resources page.
            </p>

            <div class="preview-actions">
              <span class="studio-button secondary">View Student Pack</span>
              <span id="preview-tutor-button" class="studio-button secondary muted">
                View Tutor Guide
              </span>
            </div>
          </div>

          <div class="preview-document">
            <strong>Student Pack</strong>
            <span id="preview-student-file">No Student Pack selected</span>
          </div>

          <div class="preview-document">
            <strong>Tutor Guide</strong>
            <span id="preview-tutor-file">No Tutor Guide selected</span>
          </div>

          <div id="studio-status" class="studio-status">
            Ready to create a practical skills resource.
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div id="success-modal" class="success-modal" hidden>
    <div class="success-card">
      <p class="studio-eyebrow">Published</p>
      <h2>Resource sent to GitHub</h2>
      <p>
        Netlify should now start a fresh deployment. Once the deploy finishes, the resource will appear on the Resources page.
      </p>

      <div class="success-actions">
        <a id="open-resources-page" href="/resources" class="studio-button primary" target="_blank">
          Open Resources Page
        </a>
        <a href="/admin" class="studio-button secondary">Back to Admin</a>
        <button id="close-success" type="button" class="studio-button secondary">
          Continue Editing
        </button>
      </div>
    </div>
  </div>

  <style is:inline>
    .studio-shell {
      min-height: 100vh;
      padding: 2rem 0 4rem;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.18), transparent 32%),
        linear-gradient(180deg, #f8f1e4 0%, #fbf7ef 100%);
      color: #061b31;
    }

    .studio-topbar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      margin-bottom: 2rem;
    }

    .studio-back,
    .studio-preview {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      font-size: 0.92rem;
    }

    .studio-back {
      background: #061b31;
      color: #ffffff;
    }

    .studio-preview {
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.28);
    }

    .studio-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.8fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: clamp(1.5rem, 4vw, 3rem);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.3);
      box-shadow: 0 28px 90px rgba(6, 27, 49, 0.12);
    }

    .studio-eyebrow {
      margin: 0 0 0.7rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
    }

    .studio-hero h1 {
      max-width: 920px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.6rem, 5vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #061b31;
    }

    .studio-hero p:not(.studio-eyebrow) {
      max-width: 760px;
      margin: 1rem 0 0;
      color: #334155;
      line-height: 1.7;
      font-size: 1.08rem;
    }

    .studio-guide {
      padding: 1.3rem;
      border-radius: 24px;
      background: #061b31;
      color: #ffffff;
    }

    .studio-guide h2 {
      margin: 0 0 1rem;
      color: #ffffff;
      font-family: Georgia, "Times New Roman", serif;
    }

    .studio-guide ol {
      margin: 0;
      padding-left: 1.2rem;
      display: grid;
      gap: 0.65rem;
      color: rgba(255, 255, 255, 0.86);
      line-height: 1.5;
    }

    .studio-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(360px, 0.65fr);
      gap: 1.5rem;
      align-items: start;
      margin-top: 2rem;
    }

    .studio-form,
    .studio-preview-panel {
      display: grid;
      gap: 1rem;
    }

    .form-card,
    .studio-preview-panel {
      padding: 1.4rem;
      border-radius: 26px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
    }

    label {
      display: grid;
      gap: 0.5rem;
      color: #061b31;
      font-weight: 900;
      margin-top: 1rem;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid rgba(201, 150, 82, 0.34);
      border-radius: 16px;
      padding: 0.9rem 1rem;
      font: inherit;
      color: #061b31;
      background: #ffffff;
    }

    textarea {
      resize: vertical;
    }

    input:focus,
    textarea:focus,
    select:focus {
      outline: 3px solid rgba(211, 155, 69, 0.18);
      border-color: #d39b45;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .upload-box {
      min-height: 190px;
      align-items: center;
      justify-items: center;
      text-align: center;
      padding: 2rem;
      border-radius: 24px;
      border: 2px dashed rgba(211, 155, 69, 0.5);
      background: rgba(248, 241, 228, 0.6);
      cursor: pointer;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .upload-box:hover {
      border-color: #d39b45;
      transform: translateY(-2px);
    }

    .tutor-upload {
      border-color: rgba(6, 27, 49, 0.22);
    }

    .upload-box span {
      font-size: 1.1rem;
      color: #061b31;
    }

    .upload-box strong {
      color: #b37b32;
      overflow-wrap: anywhere;
    }

    .upload-box small {
      max-width: 520px;
      color: #64748b;
      line-height: 1.5;
    }

    .clear-file-button {
      margin-top: 1rem;
      width: fit-content;
    }

    .form-actions,
    .success-actions,
    .preview-actions {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .studio-button {
      border: 0;
      min-height: 46px;
      padding: 0.8rem 1.15rem;
      border-radius: 999px;
      font-weight: 900;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.94rem;
      text-align: center;
    }

    .studio-button.primary {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
      box-shadow: 0 12px 28px rgba(211, 155, 69, 0.22);
    }

    .studio-button.secondary {
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.32);
    }

    .studio-button.secondary.muted {
      opacity: 0.55;
    }

    .studio-button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .studio-preview-panel {
      position: sticky;
      top: 1rem;
    }

    .resource-preview-card {
      padding: 1.2rem;
      border-radius: 24px;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.18), transparent 34%),
        #ffffff;
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 14px 40px rgba(6, 27, 49, 0.08);
      overflow: hidden;
    }

    .preview-card-top {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .preview-card-top span,
    .preview-skill {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      padding: 0.42rem 0.7rem;
      border-radius: 999px;
      background: rgba(211, 155, 69, 0.13);
      color: #061b31;
      font-weight: 900;
      font-size: 0.78rem;
      overflow-wrap: anywhere;
    }

    .preview-skill {
      margin: 0 0 0.9rem;
      background: rgba(6, 27, 49, 0.06);
      color: #334155;
    }

    .resource-preview-card h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      line-height: 1.05;
      color: #061b31;
      overflow-wrap: anywhere;
      hyphens: auto;
    }

    .resource-preview-card p {
      color: #334155;
      line-height: 1.65;
      overflow-wrap: anywhere;
    }

    .preview-document {
      display: grid;
      gap: 0.3rem;
      padding: 1rem;
      border-radius: 18px;
      background: rgba(6, 27, 49, 0.04);
      border: 1px solid rgba(6, 27, 49, 0.08);
    }

    .preview-document strong {
      color: #061b31;
    }

    .preview-document span {
      color: #64748b;
      overflow-wrap: anywhere;
    }

    .studio-status {
      padding: 0.9rem 1rem;
      border-radius: 18px;
      background: #061b31;
      color: #ffffff;
      font-weight: 800;
      line-height: 1.45;
    }

    .success-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: grid;
      place-items: center;
      padding: 1.5rem;
      background: rgba(6, 27, 49, 0.55);
      backdrop-filter: blur(10px);
    }

    .success-modal[hidden] {
      display: none;
    }

    .success-card {
      width: min(680px, 100%);
      padding: 2rem;
      border-radius: 28px;
      background: #fbf7ef;
      border: 1px solid rgba(201, 150, 82, 0.32);
      box-shadow: 0 30px 90px rgba(6, 27, 49, 0.25);
      color: #061b31;
    }

    .success-card h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 4vw, 3rem);
      color: #061b31;
    }

    .success-card p:not(.studio-eyebrow) {
      color: #334155;
      line-height: 1.65;
    }

    @media (max-width: 980px) {
      .studio-hero,
      .studio-layout {
        grid-template-columns: 1fr;
      }

      .studio-preview-panel {
        position: static;
      }
    }

    @media (max-width: 680px) {
      .studio-topbar,
      .form-actions,
      .success-actions {
        align-items: flex-start;
        flex-direction: column;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .studio-back,
      .studio-preview,
      .studio-button {
        width: 100%;
      }

      .clear-file-button {
        width: 100%;
      }
    }
  </style>

  <script>
    const form = document.getElementById("resource-form");

    const codeInput = document.getElementById("resource-code");
    const categoryInput = document.getElementById("resource-category");
    const titleInput = document.getElementById("resource-title");
    const scenarioInput = document.getElementById("resource-scenario");
    const skillInput = document.getElementById("resource-skill");
    const difficultyInput = document.getElementById("resource-difficulty");
    const summaryInput = document.getElementById("resource-summary");

    const studentFileInput = document.getElementById("student-file");
    const tutorFileInput = document.getElementById("tutor-file");
    const studentFileName = document.getElementById("student-file-name");
    const tutorFileName = document.getElementById("tutor-file-name");
    const clearTutorFile = document.getElementById("clear-tutor-file");

    const publishButton = document.getElementById("publish-resource");
    const resetButton = document.getElementById("reset-form");

    const previewCode = document.getElementById("preview-code");
    const previewDifficulty = document.getElementById("preview-difficulty");
    const previewSkill = document.getElementById("preview-skill");
    const previewTitle = document.getElementById("preview-title");
    const previewScenario = document.getElementById("preview-scenario");
    const previewSummary = document.getElementById("preview-summary");
    const previewStudentFile = document.getElementById("preview-student-file");
    const previewTutorFile = document.getElementById("preview-tutor-file");
    const previewTutorButton = document.getElementById("preview-tutor-button");
    const statusBox = document.getElementById("studio-status");

    const successModal = document.getElementById("success-modal");
    const closeSuccess = document.getElementById("close-success");

    let selectedStudentFile = null;
    let selectedTutorFile = null;

    function setStatus(message) {
      if (statusBox) {
        statusBox.textContent = message;
      }
    }

    function isAllowedPackFile(file) {
      const name = file?.name?.toLowerCase() || "";
      return name.endsWith(".docx") || name.endsWith(".pdf");
    }

    function updatePreview() {
      const code = codeInput.value.trim();
      const title = titleInput.value.trim();
      const scenario = scenarioInput.value.trim();
      const summary = summaryInput.value.trim();

      previewCode.textContent = code || "CODE";
      previewDifficulty.textContent = difficultyInput.value || "Intermediate";
      previewSkill.textContent = skillInput.value || "Advocacy and Oral Presentation";
      previewTitle.textContent = title || "Resource title will appear here";
      previewScenario.textContent = scenario || "Scenario title will appear here.";
      previewSummary.textContent =
        summary ||
        "Add a summary to preview how the resource card will look on the Resources page.";

      previewStudentFile.textContent = selectedStudentFile?.name || "No Student Pack selected";
      previewTutorFile.textContent = selectedTutorFile?.name || "No Tutor Guide selected";

      if (previewTutorButton) {
        previewTutorButton.classList.toggle("muted", !selectedTutorFile);
      }
    }

    function readFileAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();

        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error("Could not read the selected file."));
        reader.readAsDataURL(file);
      });
    }

    function resetForm() {
      form.reset();

      selectedStudentFile = null;
      selectedTutorFile = null;

      studentFileInput.value = "";
      tutorFileInput.value = "";

      studentFileName.textContent = "No Student Pack selected";
      tutorFileName.textContent = "No Tutor Guide selected";

      setStatus("Ready to create a practical skills resource.");
      updatePreview();
    }

    [
      codeInput,
      categoryInput,
      titleInput,
      scenarioInput,
      skillInput,
      difficultyInput,
      summaryInput,
    ].forEach((input) => {
      input.addEventListener("input", updatePreview);
      input.addEventListener("change", updatePreview);
    });

    studentFileInput.addEventListener("change", () => {
      const file = studentFileInput.files?.[0];

      if (!file) {
        selectedStudentFile = null;
        studentFileName.textContent = "No Student Pack selected";
        setStatus("No Student Pack selected.");
        updatePreview();
        return;
      }

      if (!isAllowedPackFile(file)) {
        selectedStudentFile = null;
        studentFileInput.value = "";
        studentFileName.textContent = "No Student Pack selected";
        setStatus("Please upload the Student Pack as a .docx or .pdf file.");
        updatePreview();
        return;
      }

      selectedStudentFile = file;
      studentFileName.textContent = file.name;
      setStatus("Student Pack selected.");
      updatePreview();
    });

    tutorFileInput.addEventListener("change", () => {
      const file = tutorFileInput.files?.[0];

      if (!file) {
        selectedTutorFile = null;
        tutorFileName.textContent = "No Tutor Guide selected";
        setStatus("No Tutor Guide selected.");
        updatePreview();
        return;
      }

      if (!isAllowedPackFile(file)) {
        selectedTutorFile = null;
        tutorFileInput.value = "";
        tutorFileName.textContent = "No Tutor Guide selected";
        setStatus("Please upload the Tutor Guide as a .docx or .pdf file.");
        updatePreview();
        return;
      }

      selectedTutorFile = file;
      tutorFileName.textContent = file.name;
      setStatus("Tutor Guide selected.");
      updatePreview();
    });

    clearTutorFile.addEventListener("click", () => {
      selectedTutorFile = null;
      tutorFileInput.value = "";
      tutorFileName.textContent = "No Tutor Guide selected";
      setStatus("Tutor Guide removed.");
      updatePreview();
    });

    resetButton.addEventListener("click", resetForm);

    if (closeSuccess && successModal) {
      closeSuccess.addEventListener("click", () => {
        successModal.hidden = true;
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      try {
        if (!window.netlifyIdentity) {
          setStatus("Netlify Identity is not loaded.");
          return;
        }

        const user = window.netlifyIdentity.currentUser();

        if (!user) {
          setStatus("Please log in before publishing.");
          window.netlifyIdentity.open("login");
          return;
        }

        if (!selectedStudentFile) {
          setStatus("Please upload a Student Pack before publishing.");
          return;
        }

        publishButton.disabled = true;
        publishButton.textContent = "Publishing...";
        setStatus("Reading resource files...");

        const token = await user.jwt();

        const studentFileBase64 = await readFileAsBase64(selectedStudentFile);
        const tutorFileBase64 = selectedTutorFile
          ? await readFileAsBase64(selectedTutorFile)
          : "";

        setStatus("Creating resource simulation entry...");

        const response = await fetch("/.netlify/functions/create-resource-upload", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            code: codeInput.value.trim(),
            category: categoryInput.value,
            title: titleInput.value.trim(),
            scenario: scenarioInput.value.trim(),
            skill: skillInput.value,
            difficulty: difficultyInput.value,
            summary: summaryInput.value.trim(),

            studentFileName: selectedStudentFile.name,
            studentFileBase64,

            tutorFileName: selectedTutorFile?.name || "",
            tutorFileBase64,
          }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Could not publish resource.");
        }

        setStatus("Resource published. Netlify is redeploying the website.");

        if (successModal) {
          successModal.hidden = false;
        }

        publishButton.textContent = "Published";
      } catch (error) {
        setStatus(error.message || "Something went wrong.");
        publishButton.disabled = false;
        publishButton.textContent = "Publish Resource";
      }
    });

    updatePreview();
  </script>
</BaseLayout>
