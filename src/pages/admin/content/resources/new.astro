---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const categories = [
  "Student",
  "Tutor",
  "Workshop",
  "Commercial Awareness",
  "Legal Skills",
  "Applications",
];

const resourceTypes = [
  "Student Pack",
  "Tutor Guide",
  "Template",
  "Checklist",
  "Guide",
  "Exercise",
];

const skillAreas = [
  "Advocacy",
  "Client Interviewing",
  "Legal Drafting",
  "Legal Research",
  "Legal Writing",
  "Case and Matter Analysis",
  "Attendance Notes",
  "Commercial Awareness",
  "Applications",
];

const difficulties = ["Beginner", "Intermediate", "Advanced"];
---

<BaseLayout title="Add Resource | LawBridge Admin">
  <section class="studio-shell">
    <div class="container">
      <div class="studio-topbar">
        <a href="/admin" class="studio-back">← Back to Admin</a>
        <a href="/resources" class="studio-preview" target="_blank">Preview Resources Page</a>
      </div>

      <header class="studio-hero">
        <div>
          <p class="studio-eyebrow">LawBridge Content Studio</p>
          <h1>Add a new resource file.</h1>
          <p>
            Upload a Word, PDF, PowerPoint or spreadsheet resource, add the key details, then publish it to the Resources page.
          </p>
        </div>

        <aside class="studio-guide">
          <h2>Publishing flow</h2>
          <ol>
            <li>Upload the resource file.</li>
            <li>Add title, category, skill and difficulty.</li>
            <li>Publish the resource.</li>
            <li>Netlify rebuilds the website.</li>
          </ol>
        </aside>
      </header>

      <div class="studio-layout">
        <form id="resource-form" class="studio-form">
          <div class="form-card">
            <p class="studio-eyebrow">Resource details</p>

            <label>
              Resource title
              <input
                id="resource-title"
                name="title"
                type="text"
                placeholder="Example: Client Interviewing Practice Pack"
                required
              />
            </label>

            <label>
              Short description
              <textarea
                id="resource-description"
                name="description"
                rows="4"
                placeholder="Optional. If left blank for a Word document, LawBridge will try to create a short description from the document."
              ></textarea>
            </label>

            <div class="form-grid">
              <label>
                Category
                <select id="resource-category" name="category">
                  {categories.map((category) => (
                    <option value={category}>{category}</option>
                  ))}
                </select>
              </label>

              <label>
                Resource type
                <select id="resource-type" name="type">
                  {resourceTypes.map((type) => (
                    <option value={type}>{type}</option>
                  ))}
                </select>
              </label>
            </div>

            <div class="form-grid">
              <label>
                Skill area
                <select id="resource-skill" name="skill">
                  {skillAreas.map((skill) => (
                    <option value={skill}>{skill}</option>
                  ))}
                </select>
              </label>

              <label>
                Difficulty
                <select id="resource-difficulty" name="difficulty">
                  {difficulties.map((difficulty) => (
                    <option value={difficulty}>{difficulty}</option>
                  ))}
                </select>
              </label>
            </div>

            <label>
              Extra notes
              <textarea
                id="resource-notes"
                name="notes"
                rows="4"
                placeholder="Optional internal or public notes about the resource."
              ></textarea>
            </label>
          </div>

          <div class="form-card">
            <p class="studio-eyebrow">Resource file</p>

            <label class="upload-box" for="resource-file">
              <span>Upload resource file</span>
              <strong id="file-name">No file selected</strong>
              <small>
                Accepted files: .docx, .pdf, .pptx or .xlsx. The file will be uploaded and linked from the Resources page.
              </small>
            </label>

            <input
              id="resource-file"
              name="file"
              type="file"
              accept=".docx,.pdf,.pptx,.xlsx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              required
              hidden
            />
          </div>

          <div class="form-actions">
            <button id="publish-resource" type="submit" class="studio-button primary">
              Publish Resource
            </button>

            <button id="reset-form" type="button" class="studio-button secondary">
              Clear Form
            </button>
          </div>
        </form>

        <aside class="studio-preview-panel">
          <p class="studio-eyebrow">Resource preview</p>
          <h2 id="preview-title">Resource title will appear here</h2>
          <p id="preview-description">
            Add a description and upload a file. This preview shows how the resource card will be prepared before publishing.
          </p>

          <div class="preview-meta">
            <span id="preview-category">Student</span>
            <span id="preview-type">Student Pack</span>
            <span id="preview-skill">Advocacy</span>
            <span id="preview-difficulty">Beginner</span>
          </div>

          <div class="preview-document">
            <strong>Uploaded file</strong>
            <span id="preview-document-name">No file selected</span>
          </div>

          <div id="studio-status" class="studio-status">
            Ready to create a new resource entry.
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div id="success-modal" class="success-modal" hidden>
    <div class="success-card">
      <p class="studio-eyebrow">Published</p>
      <h2>Resource sent to GitHub</h2>
      <p>
        Netlify should now start a fresh deployment. Once the deploy finishes, the resource will appear on the Resources page.
      </p>

      <div class="success-actions">
        <a id="open-resources-page" href="/resources" class="studio-button primary" target="_blank">
          Open Resources Page
        </a>
        <a href="/admin" class="studio-button secondary">Back to Admin</a>
        <button id="close-success" type="button" class="studio-button secondary">
          Continue Editing
        </button>
      </div>
    </div>
  </div>

  <style is:inline>
    .studio-shell {
      min-height: 100vh;
      padding: 2rem 0 4rem;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.18), transparent 32%),
        linear-gradient(180deg, #f8f1e4 0%, #fbf7ef 100%);
      color: #061b31;
    }

    .studio-topbar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      margin-bottom: 2rem;
    }

    .studio-back,
    .studio-preview {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      font-size: 0.92rem;
    }

    .studio-back {
      background: #061b31;
      color: #ffffff;
    }

    .studio-preview {
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.28);
    }

    .studio-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.8fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: clamp(1.5rem, 4vw, 3rem);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.3);
      box-shadow: 0 28px 90px rgba(6, 27, 49, 0.12);
    }

    .studio-eyebrow {
      margin: 0 0 0.7rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
    }

    .studio-hero h1 {
      max-width: 920px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.6rem, 5vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #061b31;
    }

    .studio-hero p:not(.studio-eyebrow) {
      max-width: 760px;
      margin: 1rem 0 0;
      color: #334155;
      line-height: 1.7;
      font-size: 1.08rem;
    }

    .studio-guide {
      padding: 1.3rem;
      border-radius: 24px;
      background: #061b31;
      color: #ffffff;
    }

    .studio-guide h2 {
      margin: 0 0 1rem;
      color: #ffffff;
      font-family: Georgia, "Times New Roman", serif;
    }

    .studio-guide ol {
      margin: 0;
      padding-left: 1.2rem;
      display: grid;
      gap: 0.65rem;
      color: rgba(255, 255, 255, 0.86);
      line-height: 1.5;
    }

    .studio-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.65fr);
      gap: 1.5rem;
      align-items: start;
      margin-top: 2rem;
    }

    .studio-form,
    .studio-preview-panel {
      display: grid;
      gap: 1rem;
    }

    .form-card,
    .studio-preview-panel {
      padding: 1.4rem;
      border-radius: 26px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
    }

    label {
      display: grid;
      gap: 0.5rem;
      color: #061b31;
      font-weight: 900;
      margin-top: 1rem;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid rgba(201, 150, 82, 0.34);
      border-radius: 16px;
      padding: 0.9rem 1rem;
      font: inherit;
      color: #061b31;
      background: #ffffff;
    }

    textarea {
      resize: vertical;
    }

    input:focus,
    textarea:focus,
    select:focus {
      outline: 3px solid rgba(211, 155, 69, 0.18);
      border-color: #d39b45;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .upload-box {
      min-height: 210px;
      align-items: center;
      justify-items: center;
      text-align: center;
      padding: 2rem;
      border-radius: 24px;
      border: 2px dashed rgba(211, 155, 69, 0.5);
      background: rgba(248, 241, 228, 0.6);
      cursor: pointer;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .upload-box:hover {
      border-color: #d39b45;
      transform: translateY(-2px);
    }

    .upload-box span {
      font-size: 1.1rem;
      color: #061b31;
    }

    .upload-box strong {
      color: #b37b32;
      overflow-wrap: anywhere;
    }

    .upload-box small {
      max-width: 520px;
      color: #64748b;
      line-height: 1.5;
    }

    .form-actions,
    .success-actions {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .studio-button {
      border: 0;
      min-height: 46px;
      padding: 0.8rem 1.15rem;
      border-radius: 999px;
      font-weight: 900;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.94rem;
    }

    .studio-button.primary {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
      box-shadow: 0 12px 28px rgba(211, 155, 69, 0.22);
    }

    .studio-button.secondary {
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.32);
    }

    .studio-button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .studio-preview-panel {
      position: sticky;
      top: 1rem;
    }

    .studio-preview-panel h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      line-height: 1.05;
      color: #061b31;
    }

    .studio-preview-panel p {
      color: #334155;
      line-height: 1.65;
    }

    .preview-meta {
      display: flex;
      gap: 0.55rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .preview-meta span {
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      background: rgba(211, 155, 69, 0.13);
      color: #061b31;
      font-weight: 900;
      font-size: 0.82rem;
    }

    .preview-document {
      display: grid;
      gap: 0.3rem;
      margin-top: 1.25rem;
      padding: 1rem;
      border-radius: 18px;
      background: rgba(6, 27, 49, 0.04);
      border: 1px solid rgba(6, 27, 49, 0.08);
    }

    .preview-document strong {
      color: #061b31;
    }

    .preview-document span {
      color: #64748b;
      overflow-wrap: anywhere;
    }

    .studio-status {
      margin-top: 1rem;
      padding: 0.9rem 1rem;
      border-radius: 18px;
      background: #061b31;
      color: #ffffff;
      font-weight: 800;
      line-height: 1.45;
    }

    .success-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: grid;
      place-items: center;
      padding: 1.5rem;
      background: rgba(6, 27, 49, 0.55);
      backdrop-filter: blur(10px);
    }

    .success-modal[hidden] {
      display: none;
    }

    .success-card {
      width: min(680px, 100%);
      padding: 2rem;
      border-radius: 28px;
      background: #fbf7ef;
      border: 1px solid rgba(201, 150, 82, 0.32);
      box-shadow: 0 30px 90px rgba(6, 27, 49, 0.25);
      color: #061b31;
    }

    .success-card h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 4vw, 3rem);
      color: #061b31;
    }

    .success-card p:not(.studio-eyebrow) {
      color: #334155;
      line-height: 1.65;
    }

    @media (max-width: 980px) {
      .studio-hero,
      .studio-layout {
        grid-template-columns: 1fr;
      }

      .studio-preview-panel {
        position: static;
      }
    }

    @media (max-width: 680px) {
      .studio-topbar,
      .form-actions,
      .success-actions {
        align-items: flex-start;
        flex-direction: column;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .studio-back,
      .studio-preview,
      .studio-button {
        width: 100%;
      }
    }
  </style>

  <script>
    const form = document.getElementById("resource-form");
    const titleInput = document.getElementById("resource-title");
    const descriptionInput = document.getElementById("resource-description");
    const categoryInput = document.getElementById("resource-category");
    const typeInput = document.getElementById("resource-type");
    const skillInput = document.getElementById("resource-skill");
    const difficultyInput = document.getElementById("resource-difficulty");
    const notesInput = document.getElementById("resource-notes");
    const fileInput = document.getElementById("resource-file");
    const fileName = document.getElementById("file-name");
    const publishButton = document.getElementById("publish-resource");
    const resetButton = document.getElementById("reset-form");

    const previewTitle = document.getElementById("preview-title");
    const previewDescription = document.getElementById("preview-description");
    const previewCategory = document.getElementById("preview-category");
    const previewType = document.getElementById("preview-type");
    const previewSkill = document.getElementById("preview-skill");
    const previewDifficulty = document.getElementById("preview-difficulty");
    const previewDocumentName = document.getElementById("preview-document-name");
    const statusBox = document.getElementById("studio-status");

    const successModal = document.getElementById("success-modal");
    const closeSuccess = document.getElementById("close-success");

    let selectedFile = null;

    function setStatus(message) {
      if (statusBox) {
        statusBox.textContent = message;
      }
    }

    function updatePreview() {
      const title = titleInput.value.trim();
      const description = descriptionInput.value.trim();

      previewTitle.textContent = title || "Resource title will appear here";
      previewDescription.textContent =
        description ||
        "Add a description and upload a file. This preview shows how the resource card will be prepared before publishing.";
      previewCategory.textContent = categoryInput.value || "Student";
      previewType.textContent = typeInput.value || "Student Pack";
      previewSkill.textContent = skillInput.value || "Advocacy";
      previewDifficulty.textContent = difficultyInput.value || "Beginner";
      previewDocumentName.textContent = selectedFile?.name || "No file selected";
    }

    function readFileAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();

        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error("Could not read the selected file."));
        reader.readAsDataURL(file);
      });
    }

    function isAllowedResourceFile(file) {
      const name = file?.name?.toLowerCase() || "";
      return (
        name.endsWith(".docx") ||
        name.endsWith(".pdf") ||
        name.endsWith(".pptx") ||
        name.endsWith(".xlsx")
      );
    }

    function resetForm() {
      form.reset();
      selectedFile = null;
      fileName.textContent = "No file selected";
      previewDocumentName.textContent = "No file selected";
      setStatus("Ready to create a new resource entry.");
      updatePreview();
    }

    [
      titleInput,
      descriptionInput,
      categoryInput,
      typeInput,
      skillInput,
      difficultyInput,
      notesInput,
    ].forEach((input) => {
      input.addEventListener("input", updatePreview);
      input.addEventListener("change", updatePreview);
    });

    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];

      if (!file) {
        selectedFile = null;
        fileName.textContent = "No file selected";
        setStatus("No file selected.");
        updatePreview();
        return;
      }

      if (!isAllowedResourceFile(file)) {
        selectedFile = null;
        fileInput.value = "";
        fileName.textContent = "No file selected";
        setStatus("Please upload a .docx, .pdf, .pptx or .xlsx file.");
        updatePreview();
        return;
      }

      selectedFile = file;
      fileName.textContent = file.name;
      setStatus("Resource file selected. Add the details, then publish.");
      updatePreview();
    });

    resetButton.addEventListener("click", resetForm);

    if (closeSuccess && successModal) {
      closeSuccess.addEventListener("click", () => {
        successModal.hidden = true;
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      try {
        if (!window.netlifyIdentity) {
          setStatus("Netlify Identity is not loaded.");
          return;
        }

        const user = window.netlifyIdentity.currentUser();

        if (!user) {
          setStatus("Please log in before publishing.");
          window.netlifyIdentity.open("login");
          return;
        }

        if (!selectedFile) {
          setStatus("Please upload a resource file before publishing.");
          return;
        }

        publishButton.disabled = true;
        publishButton.textContent = "Publishing...";
        setStatus("Reading resource file...");

        const token = await user.jwt();
        const fileBase64 = await readFileAsBase64(selectedFile);

        setStatus("Creating resource entry...");

        const response = await fetch("/.netlify/functions/create-resource-upload", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            title: titleInput.value.trim(),
            description: descriptionInput.value.trim(),
            category: categoryInput.value,
            type: typeInput.value,
            skill: skillInput.value,
            difficulty: difficultyInput.value,
            notes: notesInput.value.trim(),
            fileName: selectedFile.name,
            fileBase64,
          }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Could not publish resource.");
        }

        setStatus("Resource published. Netlify is redeploying the website.");

        if (successModal) {
          successModal.hidden = false;
        }

        publishButton.textContent = "Published";
      } catch (error) {
        setStatus(error.message || "Something went wrong.");
        publishButton.disabled = false;
        publishButton.textContent = "Publish Resource";
      }
    });

    updatePreview();
  </script>
</BaseLayout>
