---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Add AI Resource | LawBridge Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      body {
        margin: 0;
        background: #f8f1e4;
        color: #061b31;
        font-family: Inter, system-ui, sans-serif;
      }

      .shell {
        max-width: 980px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      .back-link {
        display: inline-flex;
        margin-bottom: 1rem;
        color: #061b31;
        font-weight: 900;
        text-decoration: none;
      }

      h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.4rem, 5vw, 4.4rem);
        line-height: 0.98;
        margin: 0 0 1rem;
      }

      .intro {
        max-width: 760px;
        color: #334155;
        line-height: 1.65;
        margin-bottom: 1.5rem;
      }

      .card {
        background: white;
        border-radius: 28px;
        padding: 28px;
        border: 1px solid rgba(201, 150, 82, 0.3);
        box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
      }

      label {
        display: block;
        font-weight: 900;
        margin-top: 1rem;
        margin-bottom: 0.4rem;
      }

      input,
      select,
      textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid rgba(6, 27, 49, 0.18);
        border-radius: 16px;
        padding: 0.9rem 1rem;
        font: inherit;
      }

      textarea {
        min-height: 150px;
        resize: vertical;
        line-height: 1.5;
      }

      .big-textarea {
        min-height: 260px;
      }

      .button-row {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
      }

      .button {
        border: 0;
        border-radius: 999px;
        padding: 0.85rem 1.3rem;
        background: linear-gradient(135deg, #e7b65f, #d39b45);
        color: #061b31;
        font-weight: 900;
        cursor: pointer;
      }

      .button.secondary {
        background: #ffffff;
        border: 1px solid rgba(201, 150, 82, 0.34);
      }

      .message {
        margin-top: 1rem;
        font-weight: 900;
        line-height: 1.5;
      }

      .hint {
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.45;
        margin-top: 0.25rem;
      }

      .notice {
        background: rgba(211, 155, 69, 0.12);
        border: 1px solid rgba(211, 155, 69, 0.3);
        border-radius: 18px;
        padding: 1rem;
        color: #061b31;
        font-weight: 700;
        line-height: 1.55;
        margin-bottom: 1.2rem;
      }
    </style>
  </head>

  <body>
    <main class="shell">
      <a class="back-link" href="/admin">← Back to Admin</a>

      <h1>Add AI Resource</h1>

      <p class="intro">
        Add a LawBridge pack to the AI knowledge base. Student content is used to guide students.
        Tutor guidance is hidden and used only for internal hints, feedback and marking support.
      </p>

      <div class="notice">
        This creates a Markdown file inside <strong>src/content/ai-knowledge</strong>. After deploy,
        the AI Skills Coach can use it through the generated pack knowledge file.
      </div>

      <div class="card">
        <form id="aiForm">
          <label for="code">Pack Code</label>
          <input id="code" name="code" placeholder="Example: CI-01" required />

          <label for="title">Pack Title</label>
          <input id="title" name="title" placeholder="Example: Failed Software Launch" required />

          <label for="skill">Skill Area</label>
          <input id="skill" name="skill" placeholder="Example: Client Interviewing" required />

          <label for="scenario">Scenario</label>
          <input id="scenario" name="scenario" placeholder="Example: The Startup Founder With a Failed Software Launch" />

          <label for="difficulty">Difficulty</label>
          <select id="difficulty" name="difficulty">
            <option>Foundation to Guided Practice</option>
            <option>Foundation to Intermediate</option>
            <option>Intermediate</option>
            <option>Intermediate to Advanced</option>
            <option>Advanced</option>
          </select>

          <label for="summary">Student-Facing Summary</label>
          <textarea
            id="summary"
            name="summary"
            placeholder="Briefly explain what this pack helps students practise."
            required
          ></textarea>

          <label for="studentKnowledge">Student Pack Knowledge</label>
          <p class="hint">
            Paste the student pack content here: task brief, learning outcomes, exhibits, practice tasks and instructions.
          </p>
          <textarea
            id="studentKnowledge"
            name="studentKnowledge"
            class="big-textarea"
            placeholder="Paste Student Pack content here..."
          ></textarea>

          <label for="tutorGuidance">Hidden Tutor Guidance</label>
          <p class="hint">
            Paste tutor-only guidance here: model answer guidance, rubrics, common mistakes, feedback notes and remediation.
          </p>
          <textarea
            id="tutorGuidance"
            name="tutorGuidance"
            class="big-textarea"
            placeholder="Paste Tutor Guide content here..."
          ></textarea>

          <div class="button-row">
            <button class="button" type="submit">Save AI Resource</button>
            <button class="button secondary" type="reset">Clear Form</button>
          </div>

          <p id="message" class="message"></p>
        </form>
      </div>
    </main>

    <script>
      const form = document.getElementById("aiForm");
      const message = document.getElementById("message");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        message.textContent = "Saving AI resource...";
        message.style.color = "#061b31";

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const response = await fetch("/.netlify/functions/create-ai-knowledge-item", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || "Save failed.");
          }

          message.textContent = `Saved successfully: ${result.path}`;
          message.style.color = "#18794e";
          form.reset();
        } catch (error) {
          message.textContent = error.message || "Something went wrong.";
          message.style.color = "#b42318";
        }
      });
    </script>
  </body>
</html>
