---
import { onMount } from "solid-js";
import fs from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, "../../..");
const aiKnowledgeDir = path.join(rootDir, "src", "content", "ai-knowledge");

let packTitle = "";
let packCode = "";
let skill = "";
let difficulty = "Intermediate";
let studentContent = "";
let tutorContent = "";
let successMessage = "";
let errorMessage = "";

async function savePack() {
  successMessage = "";
  errorMessage = "";

  if (!packTitle || !studentContent) {
    errorMessage = "Pack title and student content are required.";
    return;
  }

  try {
    const slug = packTitle.toLowerCase().replace(/[^a-z0-9]+/g, "-");
    const filePath = path.join(aiKnowledgeDir, `${slug}.md`);
    const content = `---
code: "${packCode || slug}"
title: "${packTitle}"
skill: "${skill}"
difficulty: "${difficulty}"
summary: "Uploaded via admin"
---

## Student Pack Knowledge

${studentContent}

## Hidden Tutor Guidance

${tutorContent}
`;

    await fs.mkdir(aiKnowledgeDir, { recursive: true });
    await fs.writeFile(filePath, content, "utf8");

    successMessage = `Pack saved successfully: ${slug}.md`;
    packTitle = "";
    packCode = "";
    skill = "";
    studentContent = "";
    tutorContent = "";
  } catch (e) {
    console.error(e);
    errorMessage = "Failed to save pack. Check server logs.";
  }
}
---

<div class="admin-form">
  <h2>Add New AI Knowledge Pack</h2>

  <label>Pack Title</label>
  <input type="text" bind:value={packTitle} />

  <label>Pack Code (optional)</label>
  <input type="text" bind:value={packCode} />

  <label>Skill Area</label>
  <input type="text" bind:value={skill} />

  <label>Difficulty</label>
  <select bind:value={difficulty}>
    <option>Beginner</option>
    <option>Intermediate</option>
    <option>Advanced</option>
  </select>

  <label>Student Pack Content</label>
  <textarea rows="8" bind:value={studentContent}></textarea>

  <label>Tutor Guide Content (hidden)</label>
  <textarea rows="6" bind:value={tutorContent}></textarea>

  <button type="button" onClick={savePack}>Save Pack</button>

  {successMessage && <p style="color:green">{successMessage}</p>}
  {errorMessage && <p style="color:red">{errorMessage}</p>}
</div>
