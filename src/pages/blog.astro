---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

const page = await getEntry("pages", "blog");
const data = page?.data;

const hero = data?.hero ?? {};
const sections = data?.sections ?? {};
const cards = data?.cards ?? {};
const buttons = data?.buttons ?? {};
const dashboard = data?.dashboard ?? {};

const posts = await getCollection("blog");

const sortedPosts = posts.sort((a, b) => {
  const aTime = a.data.date ? new Date(a.data.date).getTime() : 0;
  const bTime = b.data.date ? new Date(b.data.date).getTime() : 0;
  return bTime - aTime;
});

function formatDate(dateValue) {
  if (!dateValue) {
    return "Date to be confirmed";
  }

  const date = new Date(dateValue);

  if (Number.isNaN(date.getTime())) {
    return "Date to be confirmed";
  }

  return date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}
---

<BaseLayout title={data?.title ?? "Blog | LawBridge"}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.heading}</h1>
        <p class="hero-lead">{hero.description}</p>

        <div class="hero-actions">
          {hero.primaryButtonText && (
            <a class="btn primary" href={hero.primaryButtonLink}>
              {hero.primaryButtonText}
            </a>
          )}

          {hero.secondaryButtonText && (
            <a class="btn secondary" href={hero.secondaryButtonLink}>
              {hero.secondaryButtonText}
            </a>
          )}

          {hero.tertiaryButtonText && (
            <a class="btn ghost" href={hero.tertiaryButtonLink}>
              {hero.tertiaryButtonText}
            </a>
          )}
        </div>
      </div>

      {dashboard.heading && (
        <div class="dashboard-card">
          <span class="pill">{dashboard.label}</span>
          <h2>{dashboard.heading}</h2>
          <p>{dashboard.description}</p>

          <div class="dashboard-list">
            {dashboard.items?.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">Latest articles</p>
      <h2>Read LawBridge insights and guidance.</h2>
      <p class="section-intro">
        Blog posts uploaded through the LawBridge Content Studio appear here automatically after Netlify redeploys.
      </p>

      {sortedPosts.length > 0 ? (
        <div class="grid g3">
          {sortedPosts.map((post) => (
            <article class="card blog-card">
              {post.data.category && (
                <span class="pill blog-category">{post.data.category}</span>
              )}

              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>

              <div class="blog-meta">
                <span>{formatDate(post.data.date)}</span>
                {post.data.author && <span>{post.data.author}</span>}
              </div>

              <a class="btn secondary blog-button" href={`/blog/${post.slug}`}>
                Read Article
              </a>
            </article>
          ))}
        </div>
      ) : (
        <article class="card">
          <h3>No blog posts published yet</h3>
          <p>
            Add a blog post from the LawBridge admin dashboard and it will appear here automatically.
          </p>
        </article>
      )}
    </div>
  </section>

  <section class="section light">
    <div class="container">
      <p class="eyebrow">{sections.problem?.eyebrow}</p>
      <h2>{sections.problem?.heading}</h2>
      <p class="section-intro">{sections.problem?.description}</p>

      <div class="grid g3">
        {(cards.problem ?? []).map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">{sections.method?.eyebrow}</p>
      <h2>{sections.method?.heading}</h2>
      <p class="section-intro">{sections.method?.description}</p>

      <div class="grid g4">
        {(cards.method ?? []).map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section navy">
    <div class="container">
      <p class="eyebrow">{sections.curriculum?.eyebrow}</p>
      <h2>{sections.curriculum?.heading}</h2>
      <p class="section-intro">{sections.curriculum?.description}</p>

      <div class="grid g4">
        {(cards.curriculum ?? []).map((card) => (
          <article class="curric">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">{sections.pathways?.eyebrow}</p>
      <h2>{sections.pathways?.heading}</h2>
      <p class="section-intro">{sections.pathways?.description}</p>

      <div class="grid g2">
        {(cards.pathways ?? []).map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>

            {card.buttonText && (
              <a class="btn secondary" href={card.buttonLink}>
                {card.buttonText}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="container cta-panel">
      <p class="eyebrow">{sections.cta?.eyebrow}</p>
      <h2>{sections.cta?.heading}</h2>
      <p>{sections.cta?.description}</p>

      <div class="hero-actions">
        {buttons.cta?.primaryText && (
          <a class="btn primary" href={buttons.cta.primaryLink}>
            {buttons.cta.primaryText}
          </a>
        )}

        {buttons.cta?.secondaryText && (
          <a class="btn secondary" href={buttons.cta.secondaryLink}>
            {buttons.cta.secondaryText}
          </a>
        )}
      </div>
    </div>
  </section>

  <style is:inline>
    .blog-card {
      overflow: hidden;
    }

    .blog-card h3 {
      max-width: 100%;
      overflow-wrap: anywhere;
      word-break: normal;
      hyphens: auto;
      line-height: 1.08;
    }

    .blog-card p {
      overflow-wrap: anywhere;
    }

    .blog-category {
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .blog-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1rem 0;
    }

    .blog-meta span {
      display: inline-flex;
      max-width: 100%;
      padding: 0.42rem 0.7rem;
      border-radius: 999px;
      background: rgba(211, 155, 69, 0.12);
      color: #061b31;
      font-size: 0.82rem;
      font-weight: 900;
      overflow-wrap: anywhere;
    }

    .blog-button {
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }
  </style>
</BaseLayout>
