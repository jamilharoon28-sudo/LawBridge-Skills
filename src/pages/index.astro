---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const home = await getEntry("pages", "home");
const data = home?.data;

const hero = data?.hero ?? {};
const sections = data?.sections ?? {};
const cards = data?.cards ?? {};
const buttons = data?.buttons ?? {};
const dashboard = data?.dashboard ?? {};
---

<BaseLayout title={data?.title ?? "LawBridge | Practical Legal Development"}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.heading}</h1>
        <p class="hero-lead">{hero.description}</p>

        <div class="hero-actions">
          {hero.primaryButtonText && (
            <a class="btn primary" href={hero.primaryButtonLink}>
              {hero.primaryButtonText}
            </a>
          )}

          {hero.secondaryButtonText && (
            <a class="btn secondary" href={hero.secondaryButtonLink}>
              {hero.secondaryButtonText}
            </a>
          )}

          {hero.tertiaryButtonText && (
            <a class="btn ghost" href={hero.tertiaryButtonLink}>
              {hero.tertiaryButtonText}
            </a>
          )}
        </div>
      </div>

      {dashboard.heading && (
        <div class="dashboard-card">
          <span class="pill">{dashboard.label}</span>
          <h2>{dashboard.heading}</h2>
          <p>{dashboard.description}</p>

          <div class="dashboard-list">
            {dashboard.items?.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">Admin Tools</p>
      <h2>Quick Access</h2>
      <p class="section-intro">Use the links below to manage different parts of LawBridge content and the site.</p>

      <div class="grid g3">
        <article class="card">
          <h3>Single Page Editors</h3>
          <p>Edit homepage, resources, AI Skills Coach, workshops, blog, and more individually.</p>
          <a class="btn secondary" href="/admin/edit/home">Go to Editors</a>
        </article>

        <article class="card">
          <h3>Global Website Editor</h3>
          <p>Edit all pages and sections from a single editor for faster workflow and consistency.</p>
          <a class="btn gold" href="/admin/edit/global">Open Global Editor</a>
        </article>

        <article class="card">
          <h3>Other Admin Functions</h3>
          <p>Access content management for resources, packs, mentors, students, partners, and settings.</p>
          <a class="btn primary" href="/admin/content/resources/manage">Manage Resources</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Keep all other homepage sections for dashboard, problem, method, curriculum, pathways, CTA as-is -->
  <!-- You can keep the rest of your original code below without changes -->
</BaseLayout>
