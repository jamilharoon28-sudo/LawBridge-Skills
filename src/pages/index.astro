---
import Layout from "../layouts/Layout.astro";
---

<Layout title="LawBridge | Practical Legal Training">

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Practical legal development for new graduates</p>
      <h1>From Law Graduate to Practice-Ready Lawyer</h1>
      <p>Hands-on simulations, mentorship, and real-world experience to launch your legal career with confidence.</p>
      <div class="hero-buttons">
        <a class="btn primary" href="/programs">Explore Programs</a>
        <a class="btn secondary" href="/mentors">Become a Mentor</a>
        <a class="btn secondary" href="/join">Join LawBridge</a>
      </div>
    </div>
    <aside class="hero-card">
      <p class="eyebrow">Recommended next</p>
      <h2>Your next simulation</h2>
      <p>Check your progress and continue your next available LawBridge pack.</p>
      <a class="btn primary" href="/ai-skills-coach">Continue with AI Coach</a>
    </aside>
  </section>

  <!-- Why LawBridge Section -->
  <section class="why">
    <h2>A Law Degree Isn’t Enough</h2>
    <p>Employers expect more than theory. Develop practical skills that make you valuable from day one.</p>
    <div class="feature-cards">
      <div class="card">
        <h3>Practice-Ready Skills</h3>
        <p>Apply legal knowledge to real-world scenarios.</p>
      </div>
      <div class="card">
        <h3>Commercial Awareness</h3>
        <p>Understand clients, business, and markets.</p>
      </div>
      <div class="card">
        <h3>Mentorship Guidance</h3>
        <p>Learn from experienced professionals.</p>
      </div>
    </div>
  </section>

  <!-- Method / Programs Section -->
  <section class="methods">
    <h2>Practical training. Real impact.</h2>
    <div class="method-cards">
      <div class="card">
        <h3>Interactive Legal Labs</h3>
        <p>Build skills through guided practice and expert-led workshops.</p>
      </div>
      <div class="card">
        <h3>Expert Insight Sessions</h3>
        <p>Learn from leading legal professionals in live webinars.</p>
      </div>
      <div class="card">
        <h3>Guided Career Pathways</h3>
        <p>Mentorship to help you navigate the legal profession confidently.</p>
      </div>
      <div class="card">
        <h3>Actionable Learning Materials</h3>
        <p>Resources that you can use immediately to build capability.</p>
      </div>
    </div>
  </section>

  <!-- Curriculum Section -->
  <section class="curriculum">
    <h2>Develop the skills modern legal employers value</h2>
    <div class="curriculum-cards">
      <div class="card">
        <h3>Legal Skills</h3>
        <p>Research, Drafting & Analysis in Practice</p>
      </div>
      <div class="card">
        <h3>Commercial Awareness</h3>
        <p>Business-Savvy Lawyering</p>
      </div>
      <div class="card">
        <h3>Professional Development</h3>
        <p>Confidence, Communication & Career Readiness</p>
      </div>
      <div class="card">
        <h3>Future Lawyer Skills</h3>
        <p>AI, Technology & Evolving Legal Practice</p>
      </div>
    </div>
  </section>

  <!-- Pathways Section -->
  <section class="pathways">
    <h2>Choose the support that matches your stage</h2>
    <div class="pathway-cards">
      <div class="card">
        <h3>Students</h3>
        <p>Build practical legal capability alongside your studies</p>
        <a class="btn primary" href="/students">Explore Student Pathway</a>
      </div>
      <div class="card">
        <h3>Mentors</h3>
        <p>Shape the next generation of legal professionals</p>
        <a class="btn secondary" href="/mentors">Become a Mentor</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta">
    <h2>Take the leap into real-world legal practice</h2>
    <div class="cta-buttons">
      <a class="btn primary" href="/join">Join LawBridge</a>
      <a class="btn secondary" href="/partner">Partner With Us</a>
    </div>
  </section>

  <style is:inline>
    section { padding: 3rem 1.5rem; }
    h2 { font-family: Georgia, serif; font-size: clamp(2rem, 3vw, 3rem); margin-bottom: 1rem; }
    h3 { font-weight: 900; font-size: 1.3rem; margin-bottom: 0.5rem; }
    p { margin: 0; line-height: 1.5; color: #334155; }
    .hero { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; padding: 3rem; }
    .hero .eyebrow { text-transform: uppercase; font-weight: 900; color: #b37b32; margin-bottom: 0.5rem; }
    .hero h1 { font-family: Georgia, serif; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.1; }
    .hero-buttons { margin-top: 1.5rem; display: flex; gap: 1rem; }
    .btn { border-radius: 999px; padding: 0.7rem 1.2rem; font-weight: 900; text-decoration: none; }
    .btn.primary { background: linear-gradient(135deg,#e7b65f,#d39b45); color: #061b31; }
    .btn.secondary { background: #fff; border: 1px solid rgba(201,150,82,0.32); color: #061b31; }
    .feature-cards, .method-cards, .curriculum-cards, .pathway-cards { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit,minmax(250px,1fr)); margin-top: 1rem; }
  </style>
</Layout>
