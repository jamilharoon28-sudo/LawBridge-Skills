---
import { onMount } from "solid-js";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchPackTasks } from "../netlify/functions/get-pack-tasks.js";

let packCode = new URLSearchParams(location.search).get("pack") || "";
let pack = null;
let tasks = [];
let answeredTasks = 0;

async function loadPack() {
  if (!packCode) return;
  const res = await fetch(`/api/get-pack-tasks?pack=${encodeURIComponent(packCode)}`);
  const data = await res.json();
  if (data.success) {
    pack = data.pack;
    tasks = pack.tasks || [];
    answeredTasks = tasks.filter(t => t.answer).length;
  }
}

function updateProgress() {
  answeredTasks = tasks.filter(t => t.answer).length;
}

onMount(() => {
  loadPack();
});
---

<BaseLayout title={`Answer Pack | ${pack ? pack.title : "Loading..."}`}>
  <section class="answer-hero">
    <div class="container">
      <h1>{pack?.title || "Answer Pack"}</h1>
      {pack && (
        <div class="pack-meta">
          <span class="skill">{pack.skill}</span>
          <span class="difficulty">{pack.difficulty}</span>
          <span class="continue-pill">Continue Answer Pack</span>
        </div>
      )}
      {pack && (
        <progress value={answeredTasks} max={tasks.length}></progress>
      )}
    </div>
  </section>

  <section class="pack-tasks">
    <div class="container">
      {tasks.length > 0 ? (
        tasks.map(task => (
          <article class="task-card">
            <h3>{task.title}</h3>
            <p>{task.instructions}</p>
            <textarea
              value={task.answer || ""}
              onInput={(e) => {
                task.answer = e.target.value;
                updateProgress();
              }}
              placeholder="Type your answer here..."
            ></textarea>
          </article>
        ))
      ) : (
        <p>No tasks available for this pack.</p>
      )}
    </div>
  </section>

  <section class="submit-section">
    <div class="container">
      <button
        class="submit-button"
        onClick={() => {
          // Save answers and optionally send to AI Skills Coach
          console.log("Submit clicked", tasks);
        }}
      >
        Submit Answers
      </button>
    </div>
  </section>
</BaseLayout>

<style is:inline>
.answer-hero {
  padding: 2rem 0;
}
.pack-meta {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
}
.continue-pill {
  background: #e7b65f;
  padding: 0.3rem 0.6rem;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.85rem;
}
.pack-tasks {
  margin-top: 2rem;
}
.task-card {
  padding: 1rem;
  margin-bottom: 1rem;
  border-radius: 12px;
  border: 1px solid rgba(201,150,82,0.24);
  background: #fff;
}
.task-card h3 {
  margin: 0 0 0.5rem;
}
.task-card textarea {
  width: 100%;
  min-height: 100px;
  padding: 0.5rem;
  border-radius: 6px;
  border: 1px solid #ccc;
  resize: vertical;
}
.submit-section {
  margin: 2rem 0;
  text-align: right;
}
.submit-button {
  padding: 0.8rem 1.2rem;
  background: linear-gradient(135deg, #e7b65f, #d39b45);
  color: #061b31;
  border: none;
  border-radius: 999px;
  font-weight: 900;
  cursor: pointer;
}
progress {
  width: 100%;
  height: 12px;
  margin-top: 1rem;
}
</style>
