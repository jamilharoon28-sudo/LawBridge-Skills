---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const resources = await getCollection("resources");

const packs = resources
  .map((entry) => ({
    code: entry.data.code || "",
    skill: entry.data.skill || "Practical Skills",
    scenario: entry.data.scenario || entry.data.title,
    difficulty: entry.data.difficulty || "Intermediate",
    summary:
      entry.data.summary ||
      entry.data.description ||
      "A LawBridge practical skills simulation pack.",
  }))
  .filter((pack) => pack.code || pack.scenario);

const popularPacks = packs.slice(0, 5);
---

<BaseLayout title="AI Skills Coach | LawBridge">
  <section class="coach-shell">
    <div class="container">
      <div class="coach-topbar">
        <a href="/resources" class="coach-back">← Back to Resources</a>
        <span class="coach-status">Educational support only</span>
      </div>

      <header class="coach-hero">
        <div>
          <p class="coach-eyebrow">LawBridge AI Skills Coach</p>
          <h1>Ask about any LawBridge Student Pack.</h1>
          <p>
            Get hints, understand tasks, structure your answer, find evidence and improve your practical legal skills work.
          </p>
        </div>

        <aside class="coach-focus-card">
          <p class="coach-eyebrow">Current focus</p>
          <h2 id="current-pack-title">All Student Packs</h2>
          <p id="current-pack-skill">
            Ask about any practical skills simulation.
          </p>
          <button id="change-pack-button" class="coach-button secondary" type="button">
            Change Pack
          </button>
        </aside>
      </header>

      <div class="coach-layout">
        <aside class="coach-sidebar">
          <div class="coach-panel">
            <p class="coach-eyebrow">Choose a pack</p>

            <label class="coach-select-label">
              Student Pack
              <select id="pack-select">
                <option value="all">All Student Packs</option>
                {packs.map((pack) => (
                  <option
                    value={pack.code}
                    data-skill={pack.skill}
                    data-scenario={pack.scenario}
                    data-difficulty={pack.difficulty}
                  >
                    {pack.code ? `${pack.code} | ${pack.scenario}` : pack.scenario}
                  </option>
                ))}
              </select>
            </label>

            <div class="popular-list">
              <p class="coach-eyebrow">Popular packs</p>
              {popularPacks.length > 0 ? (
                popularPacks.map((pack) => (
                  <button
                    class="popular-pack"
                    type="button"
                    data-pack-code={pack.code}
                    data-pack-skill={pack.skill}
                    data-pack-scenario={pack.scenario}
                  >
                    <strong>{pack.code}</strong>
                    <span>{pack.scenario}</span>
                  </button>
                ))
              ) : (
                <p class="empty-note">No packs found yet.</p>
              )}
            </div>
          </div>

          <div class="coach-panel dark-panel">
            <p class="coach-eyebrow">How I can help</p>
            <ul>
              <li>Give hints without writing the full answer.</li>
              <li>Explain tasks in plain language.</li>
              <li>Help structure student responses.</li>
              <li>Point students towards relevant evidence.</li>
              <li>Give feedback on draft answers.</li>
            </ul>
          </div>
        </aside>

        <main class="chat-card">
          <div class="coach-mode-row">
            <button class="mode-button active" type="button" data-mode="Ask Anything">
              Ask Anything
            </button>
            <button class="mode-button" type="button" data-mode="Give Me a Hint">
              Give Me a Hint
            </button>
            <button class="mode-button" type="button" data-mode="Explain the Task">
              Explain the Task
            </button>
            <button class="mode-button" type="button" data-mode="Structure My Answer">
              Structure My Answer
            </button>
            <button class="mode-button" type="button" data-mode="Find Evidence">
              Find Evidence
            </button>
            <button class="mode-button" type="button" data-mode="Check My Answer">
              Check My Answer
            </button>
          </div>

          <div class="chat-window" id="chat-window">
            <article class="chat-message assistant-message">
              <div class="avatar">LB</div>
              <div class="message-bubble">
                <strong>LawBridge AI Skills Coach</strong>
                <p>
                  Hello. I can help you with any LawBridge practical skills simulation.
                </p>
                <p>
                  Choose a pack, pick a support mode, then ask a question about the task, evidence, structure or your draft answer.
                </p>
              </div>
            </article>
          </div>

          <form class="chat-input-area" id="chat-form">
            <div class="chat-input-bar">
              <textarea
                id="chat-input"
                rows="3"
                placeholder="Ask a question about a Student Pack..."
                autocomplete="off"
              ></textarea>

              <button class="send-button" type="submit" aria-label="Send message">
                →
              </button>
            </div>

            <div class="chat-helper-row">
              <span id="character-count">0 / 1500 characters</span>
              <span id="character-guidance">
                Use Check My Answer for longer draft feedback.
              </span>
            </div>
          </form>

          <p class="coach-disclaimer">
            LawBridge AI Skills Coach provides educational support only and does not provide legal advice.
          </p>
        </main>

        <aside class="coach-rightbar">
          <div class="coach-panel">
            <p class="coach-eyebrow">Behind the scenes</p>

            <div class="behind-item">
              <strong>Student Pack aware</strong>
              <span>Designed to answer around LawBridge simulation packs.</span>
            </div>

            <div class="behind-item">
              <strong>Tutor Guide ready</strong>
              <span>Hidden tutor guidance can support feedback mode.</span>
            </div>

            <div class="behind-item">
              <strong>LawBridge tone</strong>
              <span>Helpful, practical, educational and evidence-focused.</span>
            </div>
          </div>

          <div class="coach-panel">
            <p class="coach-eyebrow">Quality rules</p>
            <ul class="quality-list">
              <li>No legal advice.</li>
              <li>No pretending uncertain law is settled.</li>
              <li>No full model answers by default.</li>
              <li>Encourage evidence-based answers.</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <style is:inline>
    .coach-shell {
      min-height: 100vh;
      padding: 2rem 0 4rem;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.18), transparent 32%),
        linear-gradient(180deg, #f8f1e4 0%, #fbf7ef 100%);
      color: #061b31;
    }

    .coach-topbar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      margin-bottom: 2rem;
    }

    .coach-back,
    .coach-status {
      display: inline-flex;
      align-items: center;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      font-size: 0.92rem;
    }

    .coach-back {
      background: #061b31;
      color: #ffffff;
    }

    .coach-status {
      background: rgba(255, 255, 255, 0.82);
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.28);
    }

    .coach-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.8fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: clamp(1.5rem, 4vw, 3rem);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.3);
      box-shadow: 0 28px 90px rgba(6, 27, 49, 0.12);
    }

    .coach-eyebrow {
      margin: 0 0 0.7rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
    }

    .coach-hero h1 {
      max-width: 920px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.8rem, 6vw, 5.6rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #061b31;
      overflow-wrap: anywhere;
    }

    .coach-hero p:not(.coach-eyebrow),
    .coach-focus-card p,
    .coach-panel p,
    .coach-panel li {
      color: #334155;
      line-height: 1.65;
    }

    .coach-hero > div > p:not(.coach-eyebrow) {
      max-width: 760px;
      margin: 1rem 0 0;
      font-size: 1.08rem;
    }

    .coach-focus-card,
    .coach-panel,
    .chat-card {
      border: 1px solid rgba(201, 150, 82, 0.28);
      background: rgba(255, 255, 255, 0.86);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
    }

    .coach-focus-card {
      padding: 1.3rem;
      border-radius: 24px;
    }

    .coach-focus-card h2 {
      margin: 0;
      color: #061b31;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.8rem;
      line-height: 1.05;
    }

    .coach-layout {
      display: grid;
      grid-template-columns: minmax(260px, 0.65fr) minmax(0, 1.65fr) minmax(280px, 0.7fr);
      gap: 1rem;
      margin-top: 1.5rem;
      align-items: start;
    }

    .coach-sidebar,
    .coach-rightbar {
      display: grid;
      gap: 1rem;
    }

    .coach-panel {
      padding: 1.2rem;
      border-radius: 24px;
    }

    .dark-panel {
      background: #061b31;
      border-color: rgba(255, 255, 255, 0.08);
    }

    .dark-panel .coach-eyebrow,
    .dark-panel li {
      color: #ffffff;
    }

    .coach-select-label {
      display: grid;
      gap: 0.5rem;
      color: #061b31;
      font-weight: 900;
    }

    .coach-select-label select,
    .chat-input-bar textarea {
      width: 100%;
      border: 1px solid rgba(201, 150, 82, 0.34);
      border-radius: 16px;
      padding: 0.9rem 1rem;
      font: inherit;
      color: #061b31;
      background: #ffffff;
    }

    .chat-input-bar textarea {
      resize: vertical;
      min-height: 76px;
      max-height: 210px;
      line-height: 1.45;
    }

    .chat-input-bar textarea:focus,
    .coach-select-label select:focus {
      outline: 3px solid rgba(211, 155, 69, 0.18);
      border-color: #d39b45;
    }

    .popular-list {
      display: grid;
      gap: 0.55rem;
      margin-top: 1.2rem;
    }

    .popular-pack {
      display: grid;
      gap: 0.2rem;
      width: 100%;
      text-align: left;
      padding: 0.8rem;
      border-radius: 16px;
      border: 1px solid rgba(201, 150, 82, 0.24);
      background: rgba(248, 241, 228, 0.52);
      cursor: pointer;
    }

    .popular-pack strong {
      color: #061b31;
    }

    .popular-pack span,
    .empty-note {
      color: #64748b;
      font-weight: 700;
    }

    .chat-card {
      padding: 1rem;
      border-radius: 26px;
    }

    .coach-mode-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-bottom: 1rem;
    }

    .mode-button,
    .coach-button,
    .send-button {
      border: 0;
      min-height: 40px;
      padding: 0.65rem 0.9rem;
      border-radius: 999px;
      font-weight: 900;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .mode-button {
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.28);
      font-size: 0.86rem;
    }

    .mode-button.active,
    .coach-button.primary,
    .send-button {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
      box-shadow: 0 12px 28px rgba(211, 155, 69, 0.22);
    }

    .coach-button.secondary {
      margin-top: 0.8rem;
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.32);
    }

    .chat-window {
      display: grid;
      gap: 1rem;
      min-height: 460px;
      max-height: 620px;
      overflow: auto;
      padding: 1rem;
      border-radius: 22px;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.08), transparent 32%),
        #fbf7ef;
      border: 1px solid rgba(201, 150, 82, 0.18);
    }

    .chat-message {
      display: flex;
      gap: 0.8rem;
      align-items: flex-start;
    }

    .user-message {
      justify-content: flex-end;
    }

    .avatar {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #061b31;
      color: #e7b65f;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 900;
    }

    .message-bubble {
      max-width: min(720px, 100%);
      padding: 1rem 1.1rem;
      border-radius: 20px;
      background: #ffffff;
      border: 1px solid rgba(201, 150, 82, 0.22);
      color: #061b31;
      line-height: 1.65;
      box-shadow: 0 12px 34px rgba(6, 27, 49, 0.06);
      overflow-wrap: anywhere;
    }

    .message-bubble.generated-reply {
      white-space: pre-wrap;
    }

    .message-bubble p {
      margin: 0.4rem 0;
    }

    .user-message .message-bubble {
      background: #061b31;
      color: #ffffff;
      border-color: #061b31;
    }

    .thinking-bubble {
      opacity: 0.78;
      font-weight: 900;
    }

    .chat-input-area {
      margin-top: 1rem;
    }

    .chat-input-bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.7rem;
      align-items: end;
    }

    .send-button {
      width: 52px;
      height: 52px;
      font-size: 1.4rem;
    }

    .send-button:disabled,
    .chat-input-bar textarea:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .chat-helper-row {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.55rem;
      color: #64748b;
      font-size: 0.86rem;
      font-weight: 800;
    }

    .chat-helper-row.too-long {
      color: #7f1d1d;
    }

    .coach-disclaimer {
      margin: 0.8rem 0 0;
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .behind-item {
      display: grid;
      gap: 0.25rem;
      padding: 0.8rem;
      border-radius: 16px;
      background: rgba(248, 241, 228, 0.58);
      margin-top: 0.7rem;
    }

    .behind-item strong {
      color: #061b31;
    }

    .behind-item span {
      color: #64748b;
      line-height: 1.5;
      font-weight: 700;
    }

    .quality-list {
      margin: 0;
      padding-left: 1.2rem;
      display: grid;
      gap: 0.5rem;
    }

    @media (max-width: 1180px) {
      .coach-layout,
      .coach-hero {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .coach-topbar,
      .chat-input-bar {
        grid-template-columns: 1fr;
      }

      .coach-topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .coach-back,
      .coach-status,
      .mode-button,
      .coach-button,
      .send-button {
        width: 100%;
      }

      .send-button {
        height: 46px;
      }

      .user-message {
        justify-content: flex-start;
      }
    }
  </style>

  <script is:inline>
    const STANDARD_MESSAGE_LIMIT = 1500;
    const FEEDBACK_MESSAGE_LIMIT = 2500;

    const packSelect = document.getElementById("pack-select");
    const currentPackTitle = document.getElementById("current-pack-title");
    const currentPackSkill = document.getElementById("current-pack-skill");
    const changePackButton = document.getElementById("change-pack-button");
    const popularPacks = document.querySelectorAll(".popular-pack");
    const modeButtons = document.querySelectorAll(".mode-button");
    const chatForm = document.getElementById("chat-form");
    const chatInput = document.getElementById("chat-input");
    const chatWindow = document.getElementById("chat-window");
    const sendButton = document.querySelector(".send-button");
    const characterCount = document.getElementById("character-count");
    const characterGuidance = document.getElementById("character-guidance");
    const chatHelperRow = document.querySelector(".chat-helper-row");

    let selectedPack = {
      code: "",
      scenario: "",
      skill: "",
    };

    function getActiveMode() {
      return document.querySelector(".mode-button.active")?.dataset.mode || "Ask Anything";
    }

    function getCurrentLimit() {
      return getActiveMode() === "Check My Answer"
        ? FEEDBACK_MESSAGE_LIMIT
        : STANDARD_MESSAGE_LIMIT;
    }

    function updateCharacterCounter() {
      if (!chatInput || !characterCount) {
        return;
      }

      const currentLength = chatInput.value.length;
      const currentLimit = getCurrentLimit();
      const isTooLong = currentLength > currentLimit;

      characterCount.textContent = `${currentLength} / ${currentLimit} characters`;

      if (characterGuidance) {
        characterGuidance.textContent =
          getActiveMode() === "Check My Answer"
            ? "Paste one draft section at a time for focused feedback."
            : "Use Check My Answer for longer draft feedback.";
      }

      if (chatHelperRow) {
        chatHelperRow.classList.toggle("too-long", isTooLong);
      }

      if (sendButton) {
        sendButton.disabled = isTooLong;
      }
    }

    function setCurrentPack({ code = "", scenario = "", skill = "" }) {
      selectedPack = {
        code,
        scenario,
        skill,
      };

      if (currentPackTitle) {
        currentPackTitle.textContent =
          code && scenario ? `${code} | ${scenario}` : "All Student Packs";
      }

      if (currentPackSkill) {
        currentPackSkill.textContent =
          skill || "Ask about any practical skills simulation.";
      }
    }

    function findPackOptionByCode(code) {
      if (!packSelect || !code) {
        return null;
      }

      return Array.from(packSelect.options).find(
        (option) => option.value.toLowerCase() === code.toLowerCase()
      );
    }

    function setControlsDisabled(isDisabled) {
      if (chatInput) {
        chatInput.disabled = isDisabled;
      }

      if (sendButton) {
        sendButton.disabled = isDisabled;
      }

      if (!isDisabled) {
        updateCharacterCounter();
      }
    }

    function scrollChatToBottom() {
      if (chatWindow) {
        chatWindow.scrollTop = chatWindow.scrollHeight;
      }
    }

    function addUserMessage(text) {
      const wrapper = document.createElement("article");
      wrapper.className = "chat-message user-message";

      const bubble = document.createElement("div");
      bubble.className = "message-bubble";
      bubble.textContent = text;

      wrapper.appendChild(bubble);
      chatWindow.appendChild(wrapper);
      scrollChatToBottom();
    }

    function addAssistantMessage(text, options = {}) {
      if (!chatWindow || !text) {
        return null;
      }

      const wrapper = document.createElement("article");
      wrapper.className = "chat-message assistant-message";

      if (options.thinking) {
        wrapper.dataset.thinking = "true";
      }

      const avatar = document.createElement("div");
      avatar.className = "avatar";
      avatar.textContent = "LB";

      const bubble = document.createElement("div");
      bubble.className = options.generated
        ? "message-bubble generated-reply"
        : "message-bubble";

      if (options.thinking) {
        bubble.classList.add("thinking-bubble");
      }

      const strong = document.createElement("strong");
      strong.textContent = "LawBridge AI Skills Coach";

      const paragraph = document.createElement("p");
      paragraph.textContent = text;

      bubble.appendChild(strong);
      bubble.appendChild(paragraph);
      wrapper.appendChild(avatar);
      wrapper.appendChild(bubble);

      chatWindow.appendChild(wrapper);
      scrollChatToBottom();

      return wrapper;
    }

    function removeMessage(messageElement) {
      if (messageElement && messageElement.parentNode) {
        messageElement.parentNode.removeChild(messageElement);
      }
    }

    function loadPackFromUrl() {
      const params = new URLSearchParams(window.location.search);

      const urlPack = params.get("pack") || "";
      const urlScenario = params.get("scenario") || "";
      const urlSkill = params.get("skill") || "";

      if (!urlPack && !urlScenario && !urlSkill) {
        setCurrentPack({});
        return;
      }

      const matchingOption = findPackOptionByCode(urlPack);

      if (matchingOption && packSelect) {
        packSelect.value = matchingOption.value;

        setCurrentPack({
          code: matchingOption.value,
          scenario: matchingOption.dataset.scenario || urlScenario,
          skill: matchingOption.dataset.skill || urlSkill,
        });

        addAssistantMessage(
          `You are now focused on ${matchingOption.value} | ${
            matchingOption.dataset.scenario || urlScenario
          }. Ask me for hints, structure, evidence support or feedback.`
        );

        return;
      }

      setCurrentPack({
        code: urlPack,
        scenario: urlScenario,
        skill: urlSkill,
      });

      addAssistantMessage(
        `You are now focused on ${urlPack || "this pack"}${
          urlScenario ? ` | ${urlScenario}` : ""
        }. Ask me for hints, structure, evidence support or feedback.`
      );
    }

    async function askLawBridgeCoach(message) {
      const response = await fetch("/.netlify/functions/ai-skills-coach", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          message,
          mode: getActiveMode(),
          packCode: selectedPack.code,
          scenario: selectedPack.scenario,
          skill: selectedPack.skill,
        }),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          result.details ||
            result.error ||
            "The LawBridge AI Skills Coach could not respond."
        );
      }

      return result.answer || "I could not generate a response this time.";
    }

    packSelect?.addEventListener("change", () => {
      const selectedOption = packSelect.selectedOptions[0];

      if (!selectedOption || selectedOption.value === "all") {
        setCurrentPack({});
        return;
      }

      setCurrentPack({
        code: selectedOption.value,
        scenario: selectedOption.dataset.scenario,
        skill: selectedOption.dataset.skill,
      });
    });

    changePackButton?.addEventListener("click", () => {
      packSelect?.focus();
    });

    popularPacks.forEach((button) => {
      button.addEventListener("click", () => {
        const code = button.dataset.packCode;

        if (packSelect && code) {
          const matchingOption = findPackOptionByCode(code);

          if (matchingOption) {
            packSelect.value = matchingOption.value;
          }
        }

        setCurrentPack({
          code,
          scenario: button.dataset.packScenario,
          skill: button.dataset.packSkill,
        });
      });
    });

    modeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        modeButtons.forEach((item) => item.classList.remove("active"));
        button.classList.add("active");

        if (chatInput) {
          chatInput.placeholder =
            getActiveMode() === "Check My Answer"
              ? "Paste a short draft section for feedback..."
              : "Ask a question about a Student Pack...";
        }

        updateCharacterCounter();
      });
    });

    chatInput?.addEventListener("input", updateCharacterCounter);

    chatForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const message = chatInput.value.trim();
      const currentLimit = getCurrentLimit();

      if (!message) {
        return;
      }

      if (message.length > currentLimit) {
        addAssistantMessage(
          `Your message is too long. Please shorten it to ${currentLimit} characters or paste only the section you want help with.`
        );
        updateCharacterCounter();
        return;
      }

      addUserMessage(message);
      chatInput.value = "";
      updateCharacterCounter();

      const thinkingMessage = addAssistantMessage("Thinking...", {
        thinking: true,
      });

      try {
        setControlsDisabled(true);

        const answer = await askLawBridgeCoach(message);

        removeMessage(thinkingMessage);

        addAssistantMessage(answer, {
          generated: true,
        });
      } catch (error) {
        removeMessage(thinkingMessage);

        addAssistantMessage(
          error.message ||
            "Something went wrong. Please check the AI function and environment variable."
        );
      } finally {
        setControlsDisabled(false);
        chatInput.focus();
      }
    });

    loadPackFromUrl();
    updateCharacterCounter();
  </script>
</BaseLayout>
