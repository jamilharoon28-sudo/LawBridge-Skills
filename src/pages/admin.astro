---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageCards = [
  {
    title: "Homepage",
    description: "Manage the main landing page, hero messaging and key content sections.",
    editPath: "/cms/#/collections/pages/entries/home",
    previewPath: "/",
  },
  {
    title: "About",
    description: "Update the LawBridge story, mission and platform explanation.",
    editPath: "/cms/#/collections/pages/entries/about",
    previewPath: "/about",
  },
  {
    title: "Students",
    description: "Edit student-facing messaging, pathway content and support sections.",
    editPath: "/cms/#/collections/pages/entries/students",
    previewPath: "/students",
  },
  {
    title: "Mentors",
    description: "Manage mentor-facing content, guidance sections and calls to action.",
    editPath: "/cms/#/collections/pages/entries/mentors",
    previewPath: "/mentors",
  },
  {
    title: "Resources",
    description: "Update the resources landing page and supporting content blocks.",
    editPath: "/cms/#/collections/pages/entries/resources",
    previewPath: "/resources",
  },
  {
    title: "Blog",
    description: "Edit the blog landing page and related introduction content.",
    editPath: "/cms/#/collections/pages/entries/blog",
    previewPath: "/blog",
  },
  {
    title: "Webinars",
    description: "Update webinar page messaging, page sections and buttons.",
    editPath: "/cms/#/collections/pages/entries/webinars",
    previewPath: "/webinars",
  },
  {
    title: "Workshops",
    description: "Manage workshop page messaging, page sections and buttons.",
    editPath: "/cms/#/collections/pages/entries/workshops",
    previewPath: "/workshops",
  },
];

const collectionCards = [
  {
    title: "Blog Posts",
    description: "Create, edit and manage published LawBridge articles.",
    managePath: "/cms/#/collections/blog",
    previewPath: "/blog",
  },
  {
    title: "Webinars",
    description: "Create and manage webinar listings, dates, status and details.",
    managePath: "/cms/#/collections/webinars",
    previewPath: "/webinars",
  },
  {
    title: "Workshops",
    description: "Create and manage workshop listings, dates, status and details.",
    managePath: "/cms/#/collections/workshops",
    previewPath: "/workshops",
  },
  {
    title: "Resource Entries",
    description: "Create and manage resource cards, categories and download links.",
    managePath: "/cms/#/collections/resources",
    previewPath: "/resources",
  },
];

const workflowSteps = [
  "Choose a page or collection.",
  "Edit the relevant content fields.",
  "Save and publish your changes.",
  "Review the live page after deployment.",
];
---

<BaseLayout title="LawBridge Admin Dashboard">
  <section class="admin-shell">
    <div class="container">
      <div class="admin-topbar">
        <a href="/" class="admin-logo-link" aria-label="Back to LawBridge website">
          <img src="/images/lawbridge-logo.png" alt="LawBridge" />
        </a>

        <div class="admin-auth-panel">
          <span id="admin-status">Checking sign-in...</span>
          <a href="/login" class="admin-small-link">Login</a>
          <button id="admin-logout" type="button">Log out</button>
        </div>
      </div>

      <header class="admin-hero-panel">
        <div>
          <p class="admin-eyebrow">Private LawBridge Area</p>
          <h1>LawBridge Admin Dashboard</h1>
          <p>
            Manage LawBridge website pages, published content and key platform updates from one central dashboard.
          </p>
        </div>

        <aside class="admin-guide-card">
          <h2>Publishing workflow</h2>
          <ol>
            {workflowSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <a href="/cms/" class="admin-button primary full">Open Full CMS</a>
        </aside>
      </header>

      <section class="admin-section-block">
        <div class="admin-section-heading">
          <div>
            <p class="admin-eyebrow">Main website pages</p>
            <h2>Quick edit pages</h2>
          </div>
          <a href="/" class="admin-button secondary" target="_blank">Preview Website</a>
        </div>

        <div class="admin-card-grid pages-grid">
          {pageCards.map((card) => (
            <article class="admin-card">
              <div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>

              <div class="admin-actions">
                <a href={card.editPath} class="admin-button primary">Edit</a>
                <a href={card.previewPath} class="admin-button secondary" target="_blank">Preview</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="admin-section-block">
        <div class="admin-section-heading">
          <div>
            <p class="admin-eyebrow">Content collections</p>
            <h2>Manage content</h2>
          </div>
        </div>

        <div class="admin-card-grid content-grid">
          {collectionCards.map((card) => (
            <article class="admin-card feature-card">
              <div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>

              <div class="admin-actions">
                <a href={card.managePath} class="admin-button primary">Manage</a>
                <a href={card.previewPath} class="admin-button secondary" target="_blank">Preview</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <style is:inline>
    .admin-shell {
      min-height: 100vh;
      padding: 2rem 0 4rem;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.18), transparent 32%),
        linear-gradient(180deg, #f8f1e4 0%, #fbf7ef 100%);
      color: #061b31;
    }

    .admin-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .admin-logo-link {
      display: inline-flex;
      align-items: center;
      padding: 0.6rem 0.8rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 16px 45px rgba(6, 27, 49, 0.08);
    }

    .admin-logo-link img {
      width: 160px;
      height: auto;
      display: block;
    }

    .admin-auth-panel {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      flex-wrap: wrap;
      padding: 0.75rem 0.9rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 16px 45px rgba(6, 27, 49, 0.08);
      color: #26384c;
      font-weight: 800;
      font-size: 0.92rem;
    }

    .admin-small-link,
    .admin-auth-panel button {
      border: 1px solid rgba(201, 150, 82, 0.34);
      background: #ffffff;
      color: #061b31;
      padding: 0.55rem 0.85rem;
      border-radius: 999px;
      font-weight: 900;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .admin-hero-panel {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.8fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: clamp(1.5rem, 4vw, 3rem);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.3);
      box-shadow: 0 28px 90px rgba(6, 27, 49, 0.12);
    }

    .admin-eyebrow {
      margin: 0 0 0.7rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
    }

    .admin-hero-panel h1 {
      max-width: 920px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.8rem, 6vw, 5.8rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #061b31;
    }

    .admin-hero-panel p:not(.admin-eyebrow),
    .admin-card p {
      color: #334155;
      line-height: 1.65;
    }

    .admin-hero-panel > div > p:not(.admin-eyebrow) {
      max-width: 780px;
      margin: 1rem 0 0;
      font-size: 1.08rem;
    }

    .admin-guide-card {
      padding: 1.3rem;
      border-radius: 24px;
      background: #061b31;
      color: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .admin-guide-card h2 {
      margin: 0 0 1rem;
      color: #ffffff;
      font-family: Georgia, "Times New Roman", serif;
    }

    .admin-guide-card ol {
      margin: 0;
      padding-left: 1.2rem;
      display: grid;
      gap: 0.65rem;
      color: rgba(255, 255, 255, 0.86);
      line-height: 1.5;
    }

    .admin-section-block {
      margin-top: 2rem;
    }

    .admin-section-heading {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    .admin-section-heading h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 3vw, 3rem);
      color: #061b31;
    }

    .admin-card-grid {
      display: grid;
      gap: 1rem;
    }

    .pages-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .content-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .admin-card {
      min-height: 230px;
      padding: 1.25rem;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
    }

    .admin-card h3 {
      margin: 0 0 0.45rem;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.45rem;
      color: #061b31;
      letter-spacing: -0.02em;
    }

    .admin-card p {
      margin: 0;
      font-size: 0.95rem;
    }

    .feature-card {
      min-height: 205px;
      background: linear-gradient(145deg, #ffffff, #fbf3e5);
    }

    .admin-actions {
      display: flex;
      gap: 0.7rem;
      flex-wrap: wrap;
    }

    .admin-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      letter-spacing: 0.01em;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-button:hover {
      transform: translateY(-2px);
    }

    .admin-button.primary {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
      box-shadow: 0 12px 28px rgba(211, 155, 69, 0.22);
    }

    .admin-button.secondary {
      border: 1px solid rgba(201, 150, 82, 0.32);
      background: #ffffff;
      color: #061b31;
    }

    .admin-button.full {
      width: 100%;
      margin-top: 1.25rem;
    }

    @media (max-width: 1180px) {
      .pages-grid,
      .content-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .admin-hero-panel {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .admin-topbar,
      .admin-section-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .pages-grid,
      .content-grid {
        grid-template-columns: 1fr;
      }

      .admin-auth-panel {
        border-radius: 20px;
        align-items: flex-start;
      }
    }
  </style>

  <script is:inline>
    const adminStatus = document.getElementById("admin-status");
    const logoutButton = document.getElementById("admin-logout");

    function updateAdminStatus(message) {
      if (adminStatus) {
        adminStatus.textContent = message;
      }
    }

    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          updateAdminStatus("Not signed in");
          return;
        }

        const roles = user.app_metadata?.roles || [];

        if (!roles.includes("admin")) {
          updateAdminStatus("Signed in, but admin role is missing");
          return;
        }

        updateAdminStatus(`Signed in as ${user.email}`);
      });

      if (logoutButton) {
        logoutButton.addEventListener("click", () => {
          window.netlifyIdentity.logout();
          window.location.href = "/login";
        });
      }
    } else {
      updateAdminStatus("Netlify Identity is not loaded");
    }
  </script>
</BaseLayout>
