---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageCards = [
  {
    title: "Global Website Editor",
    description: "Edit all website page content from a single editor instead of opening each page separately.",
    editPath: "/admin/edit/global",
    previewPath: "/",
  },
  {
    title: "Homepage",
    description: "Edit the main landing page, hero messaging, cards and call-to-action sections.",
    editPath: "/admin/edit/home",
    previewPath: "/",
  },
  {
    title: "About",
    description: "Update the LawBridge story, mission and platform explanation.",
    editPath: "/admin/edit/about",
    previewPath: "/about",
  },
  {
    title: "Students",
    description: "Edit student-facing messaging, pathway content and support sections.",
    editPath: "/admin/edit/students",
    previewPath: "/students",
  },
  {
    title: "Mentors",
    description: "Manage mentor-facing content, guidance sections and calls to action.",
    editPath: "/admin/edit/mentors",
    previewPath: "/mentors",
  },
  {
    title: "Resources Page",
    description: "Update the main Resources page content and page-level sections.",
    editPath: "/admin/edit/resources",
    previewPath: "/resources",
  },
  {
    title: "Blog Page",
    description: "Edit the blog landing page introduction and supporting content.",
    editPath: "/admin/edit/blog",
    previewPath: "/blog",
  },
  {
    title: "Webinars Page",
    description: "Update webinar page messaging, page sections and buttons.",
    editPath: "/admin/edit/webinars",
    previewPath: "/webinars",
  },
  {
    title: "Workshops Page",
    description: "Manage workshop page messaging, page sections and buttons.",
    editPath: "/admin/edit/workshops",
    previewPath: "/workshops",
  },
];

const contentStudioCards = [
  {
    title: "Add Blog from Word",
    description: "Upload a .docx blog article and publish it as a formatted LawBridge blog post.",
    actionText: "Add Blog",
    actionPath: "/admin/content/blog/new",
    manageText: "Manage Blogs",
    managePath: "/admin/content/blog/manage",
    previewPath: "/blog",
  },
  {
    title: "Add Resource",
    description: "Upload a Word, PDF, PowerPoint or spreadsheet resource and create a resource card.",
    actionText: "Add Resource",
    actionPath: "/admin/content/resources/new",
    manageText: "Manage Resources",
    managePath: "/admin/content/resources/manage",
    previewPath: "/resources",
  },
  {
    title: "Add Webinar Link",
    description: "Create a webinar entry using a title, date, description and registration link.",
    actionText: "Add Webinar",
    actionPath: "/admin/content/webinars/new",
    manageText: "Manage Webinars",
    managePath: "/admin/content/webinars/manage",
    previewPath: "/webinars",
  },
  {
    title: "Add Workshop Link",
    description: "Create a workshop entry using a title, date, description and booking link.",
    actionText: "Add Workshop",
    actionPath: "/admin/content/workshops/new",
    manageText: "Manage Workshops",
    managePath: "/admin/content/workshops/manage",
    previewPath: "/workshops",
  },
];

const manageCards = [
  {
    title: "Manage Blog Posts",
    description: "Review, preview and delete published blog posts from a clean visual management page.",
    managePath: "/admin/content/blog/manage",
    addPath: "/admin/content/blog/new",
  },
  {
    title: "Manage Resources",
    description: "Review, preview and delete published resources and uploaded resource files.",
    managePath: "/admin/content/resources/manage",
    addPath: "/admin/content/resources/new",
  },
  {
    title: "Manage Webinars",
    description: "Review, preview and delete webinar entries published through the Content Studio.",
    managePath: "/admin/content/webinars/manage",
    addPath: "/admin/content/webinars/new",
  },
  {
    title: "Manage Workshops",
    description: "Review, preview and delete workshop entries published through the Content Studio.",
    managePath: "/admin/content/workshops/manage",
    addPath: "/admin/content/workshops/new",
  },
];

const workflowSteps = [
  "Choose a page or content tool.",
  "Edit visually, upload content or add a link.",
  "Publish or delete the item.",
  "Wait for Netlify to redeploy.",
  "Review the live page.",
];
---

<BaseLayout title="LawBridge Admin Dashboard">
  <section class="admin-shell">
    <div class="container">
      <div class="admin-topbar">
        <a href="/" class="admin-logo-link" aria-label="Back to LawBridge website">
          <img src="/images/lawbridge-logo.png" alt="LawBridge" />
        </a>

        <div class="admin-auth-panel">
          <span id="admin-status">Checking sign-in...</span>
          <a href="/login" class="admin-small-link">Login</a>
          <button id="admin-logout" type="button">Log out</button>
        </div>
      </div>

      <header class="admin-hero-panel">
        <div>
          <p class="admin-eyebrow">Private LawBridge Area</p>
          <h1>LawBridge Admin Dashboard</h1>
          <p>
            Manage the website, publish new content, delete outdated items and update LawBridge pages from one clean admin workspace.
          </p>
        </div>

        <aside class="admin-guide-card">
          <h2>Publishing workflow</h2>
          <ol>
            {workflowSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </aside>
      </header>

      <section class="admin-section-block">
        <div class="admin-section-heading">
          <div>
            <p class="admin-eyebrow">Content Studio</p>
            <h2>Create new content</h2>
          </div>

          <a href="/" class="admin-button secondary" target="_blank">Preview Website</a>
        </div>

        <div class="admin-card-grid studio-grid">
          {contentStudioCards.map((card) => (
            <article class="admin-card studio-card">
              <div>
                <span class="admin-card-tag">Content Studio</span>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>

              <div class="admin-actions">
                <a href={card.actionPath} class="admin-button primary">{card.actionText}</a>
                <a href={card.managePath} class="admin-button secondary">{card.manageText}</a>
                <a href={card.previewPath} class="admin-button secondary" target="_blank">Preview</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="admin-section-block">
        <div class="admin-section-heading">
          <div>
            <p class="admin-eyebrow">Manage Content</p>
            <h2>Review and delete items</h2>
          </div>
        </div>

        <div class="admin-card-grid manage-grid">
          {manageCards.map((card) => (
            <article class="admin-card manage-card">
              <div>
                <span class="admin-card-tag subtle">Manage</span>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>

              <div class="admin-actions">
                <a href={card.managePath} class="admin-button primary">Manage / Delete</a>
                <a href={card.addPath} class="admin-button secondary">Add New</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="admin-section-block">
        <div class="admin-section-heading">
          <div>
            <p class="admin-eyebrow">Visual Page Editor</p>
            <h2>Edit website pages</h2>
          </div>
        </div>

        <div class="admin-card-grid pages-grid">
          {pageCards.map((card) => (
            <article class="admin-card">
              <div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>

              <div class="admin-actions">
                <a href={card.editPath} class="admin-button primary">Edit Visually</a>
                <a href={card.previewPath} class="admin-button secondary" target="_blank">Preview</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="admin-section-block">
        <div class="admin-section-heading">
          <div>
            <p class="admin-eyebrow">Advanced Backup</p>
            <h2>Full CMS access</h2>
          </div>

          <a href="/cms/" class="admin-button secondary">Open Full CMS</a>
        </div>

        <div class="admin-note-card">
          <h3>Use this only as a backup</h3>
          <p>
            The Content Studio is now the main editing area. The full CMS remains available for advanced manual edits if needed.
          </p>
        </div>
      </section>
    </div>
  </section>

  <style is:inline>
    .admin-shell {
      min-height: 100vh;
      padding: 2rem 0 4rem;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.18), transparent 32%),
        linear-gradient(180deg, #f8f1e4 0%, #fbf7ef 100%);
      color: #061b31;
    }

    .admin-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .admin-logo-link {
      display: inline-flex;
      align-items: center;
      padding: 0.6rem 0.8rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 16px 45px rgba(6, 27, 49, 0.08);
    }

    .admin-logo-link img {
      width: 160px;
      height: auto;
      display: block;
    }

    .admin-auth-panel {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      flex-wrap: wrap;
      padding: 0.75rem 0.9rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 16px 45px rgba(6, 27, 49, 0.08);
      color: #26384c;
      font-weight: 800;
      font-size: 0.92rem;
    }

    .admin-small-link,
    .admin-auth-panel button {
      border: 1px solid rgba(201, 150, 82, 0.34);
      background: #ffffff;
      color: #061b31;
      padding: 0.55rem 0.85rem;
      border-radius: 999px;
      font-weight: 900;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .admin-hero-panel {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.8fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: clamp(1.5rem, 4vw, 3rem);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.3);
      box-shadow: 0 28px 90px rgba(6, 27, 49, 0.12);
    }

    .admin-eyebrow {
      margin: 0 0 0.7rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
    }

    .admin-hero-panel h1 {
      max-width: 920px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.8rem, 6vw, 5.8rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #061b31;
      overflow-wrap: anywhere;
    }

    .admin-hero-panel p:not(.admin-eyebrow),
    .admin-card p,
    .admin-note-card p {
      color: #334155;
      line-height: 1.65;
    }

    .admin-hero-panel > div > p:not(.admin-eyebrow) {
      max-width: 780px;
      margin: 1rem 0 0;
      font-size: 1.08rem;
    }

    .admin-guide-card {
      padding: 1.3rem;
      border-radius: 24px;
      background: #061b31;
      color: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .admin-guide-card h2 {
      margin: 0 0 1rem;
      color: #ffffff;
      font-family: Georgia, "Times New Roman", serif;
    }

    .admin-guide-card ol {
      margin: 0;
      padding-left: 1.2rem;
      display: grid;
      gap: 0.65rem;
      color: rgba(255, 255, 255, 0.86);
      line-height: 1.5;
    }

    .admin-section-block {
      margin-top: 2rem;
    }

    .admin-section-heading {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    .admin-section-heading h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 3vw, 3rem);
      color: #061b31;
    }

    .admin-card-grid {
      display: grid;
      gap: 1rem;
    }

    .studio-grid,
    .manage-grid,
    .pages-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .admin-card {
      min-height: 230px;
      padding: 1.25rem;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
      overflow: hidden;
    }

    .studio-card {
      min-height: 285px;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.25), transparent 36%),
        linear-gradient(145deg, #ffffff, #fbf3e5);
      border-color: rgba(211, 155, 69, 0.36);
    }

    .manage-card {
      min-height: 240px;
      background:
        radial-gradient(circle at top right, rgba(6, 27, 49, 0.06), transparent 35%),
        rgba(255, 255, 255, 0.86);
    }

    .admin-note-card {
      padding: 1.5rem;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.76);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.08);
    }

    .admin-note-card h3 {
      margin: 0 0 0.5rem;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.5rem;
      color: #061b31;
    }

    .admin-note-card p {
      margin: 0;
      max-width: 760px;
    }

    .admin-card-tag {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      margin-bottom: 0.75rem;
      padding: 0.42rem 0.7rem;
      border-radius: 999px;
      background: rgba(211, 155, 69, 0.14);
      color: #8a5a18;
      font-size: 0.72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .admin-card-tag.subtle {
      background: rgba(6, 27, 49, 0.06);
      color: #334155;
    }

    .admin-card h3 {
      margin: 0 0 0.45rem;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.45rem;
      color: #061b31;
      letter-spacing: -0.02em;
      overflow-wrap: anywhere;
      hyphens: auto;
    }

    .studio-card h3 {
      font-size: 1.6rem;
    }

    .admin-card p {
      margin: 0;
      font-size: 0.95rem;
      overflow-wrap: anywhere;
    }

    .admin-actions {
      display: flex;
      gap: 0.7rem;
      flex-wrap: wrap;
    }

    .admin-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      letter-spacing: 0.01em;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      text-align: center;
    }

    .admin-button:hover {
      transform: translateY(-2px);
    }

    .admin-button.primary {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
      box-shadow: 0 12px 28px rgba(211, 155, 69, 0.22);
    }

    .admin-button.secondary {
      border: 1px solid rgba(201, 150, 82, 0.32);
      background: #ffffff;
      color: #061b31;
    }

    @media (max-width: 1180px) {
      .studio-grid,
      .manage-grid,
      .pages-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .admin-hero-panel {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .admin-topbar,
      .admin-section-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .studio-grid,
      .manage-grid,
      .pages-grid {
        grid-template-columns: 1fr;
      }

      .admin-auth-panel {
        border-radius: 20px;
        align-items: flex-start;
      }

      .admin-actions,
      .admin-button {
        width: 100%;
      }
    }
  </style>

  <script is:inline>
    const adminStatus = document.getElementById("admin-status");
    const logoutButton = document.getElementById("admin-logout");

    function updateAdminStatus(message) {
      if (adminStatus) {
        adminStatus.textContent = message;
      }
    }

    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          updateAdminStatus("Not signed in");
          return;
        }

        updateAdminStatus(`Signed in as ${user.email}`);
      });

      if (logoutButton) {
        logoutButton.addEventListener("click", () => {
          window.netlifyIdentity.logout();
          window.location.href = "/login";
        });
      }
    } else {
      updateAdminStatus("Netlify Identity is not loaded");
    }
  </script>
</BaseLayout>
