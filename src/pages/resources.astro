---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

const page = await getEntry("pages", "resources");
const data = page?.data;

const hero = data?.hero ?? {};
const sections = data?.sections ?? {};
const cards = data?.cards ?? {};
const buttons = data?.buttons ?? {};
const dashboard = data?.dashboard ?? {};

const resources = await getCollection("resources");

const sortedResources = resources.sort((a, b) => {
  const titleA = String(a.data.title ?? "").toLowerCase();
  const titleB = String(b.data.title ?? "").toLowerCase();
  return titleA.localeCompare(titleB);
});

const categories = [...new Set(sortedResources.map((resource) => resource.data.category).filter(Boolean))];
const types = [...new Set(sortedResources.map((resource) => resource.data.type).filter(Boolean))];
const skills = [...new Set(sortedResources.map((resource) => resource.data.skill).filter(Boolean))];
const difficulties = [...new Set(sortedResources.map((resource) => resource.data.difficulty).filter(Boolean))];

function getDownloadLink(resource) {
  return resource.data.downloadLink || resource.data.link || "";
}
---

<BaseLayout title={data?.title ?? "Resources | LawBridge"}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.heading}</h1>
        <p class="hero-lead">{hero.description}</p>

        <div class="hero-actions">
          {hero.primaryButtonText && (
            <a class="btn primary" href={hero.primaryButtonLink}>
              {hero.primaryButtonText}
            </a>
          )}

          {hero.secondaryButtonText && (
            <a class="btn secondary" href={hero.secondaryButtonLink}>
              {hero.secondaryButtonText}
            </a>
          )}

          {hero.tertiaryButtonText && (
            <a class="btn ghost" href={hero.tertiaryButtonLink}>
              {hero.tertiaryButtonText}
            </a>
          )}
        </div>
      </div>

      {dashboard.heading && (
        <div class="dashboard-card">
          <span class="pill">{dashboard.label}</span>
          <h2>{dashboard.heading}</h2>
          <p>{dashboard.description}</p>

          <div class="dashboard-list">
            {dashboard.items?.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">Resource Library</p>
      <h2>Browse LawBridge resources.</h2>
      <p class="section-intro">
        Resources uploaded through the LawBridge Content Studio appear here automatically after Netlify redeploys.
      </p>

      <div class="resource-tools">
        <label>
          Search resources
          <input
            id="resource-search"
            type="search"
            placeholder="Search by title, description, skill or type..."
          />
        </label>

        <div class="resource-filter-grid">
          <label>
            Category
            <select id="resource-category-filter">
              <option value="all">All categories</option>
              {categories.map((category) => (
                <option value={category}>{category}</option>
              ))}
            </select>
          </label>

          <label>
            Type
            <select id="resource-type-filter">
              <option value="all">All types</option>
              {types.map((type) => (
                <option value={type}>{type}</option>
              ))}
            </select>
          </label>

          <label>
            Skill
            <select id="resource-skill-filter">
              <option value="all">All skills</option>
              {skills.map((skill) => (
                <option value={skill}>{skill}</option>
              ))}
            </select>
          </label>

          <label>
            Difficulty
            <select id="resource-difficulty-filter">
              <option value="all">All difficulties</option>
              {difficulties.map((difficulty) => (
                <option value={difficulty}>{difficulty}</option>
              ))}
            </select>
          </label>
        </div>
      </div>

      <div id="resource-count" class="resource-count">
        {sortedResources.length} resources available.
      </div>

      {sortedResources.length > 0 ? (
        <div class="grid g3 resource-grid" id="resource-grid">
          {sortedResources.map((resource) => (
            <article
              class="card resource-card"
              data-resource-card
              data-title={resource.data.title ?? ""}
              data-description={resource.data.description ?? ""}
              data-category={resource.data.category ?? ""}
              data-type={resource.data.type ?? ""}
              data-skill={resource.data.skill ?? ""}
              data-difficulty={resource.data.difficulty ?? ""}
            >
              <div>
                {resource.data.category && (
                  <span class="pill resource-category">{resource.data.category}</span>
                )}

                <h3>{resource.data.title}</h3>
                <p>{resource.data.description}</p>

                <div class="resource-meta">
                  {resource.data.type && <span>{resource.data.type}</span>}
                  {resource.data.skill && <span>{resource.data.skill}</span>}
                  {resource.data.difficulty && (
                    <span class="difficulty-badge">{resource.data.difficulty}</span>
                  )}
                </div>
              </div>

              {getDownloadLink(resource) ? (
                <a class="btn secondary resource-button" href={getDownloadLink(resource)} download>
                  Download Resource
                </a>
              ) : (
                <span class="btn secondary resource-button unavailable">
                  No download link
                </span>
              )}
            </article>
          ))}
        </div>
      ) : (
        <article class="card">
          <h3>No resources published yet</h3>
          <p>
            Add a resource from the LawBridge admin dashboard and it will appear here automatically.
          </p>
        </article>
      )}

      <article id="resource-empty" class="card resource-empty" hidden>
        <h3>No matching resources found</h3>
        <p>
          Try changing your search or filters.
        </p>
      </article>
    </div>
  </section>

  <section class="section light">
    <div class="container">
      <p class="eyebrow">{sections.problem?.eyebrow}</p>
      <h2>{sections.problem?.heading}</h2>
      <p class="section-intro">{sections.problem?.description}</p>

      <div class="grid g3">
        {(cards.problem ?? []).map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">{sections.method?.eyebrow}</p>
      <h2>{sections.method?.heading}</h2>
      <p class="section-intro">{sections.method?.description}</p>

      <div class="grid g4">
        {(cards.method ?? []).map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section navy">
    <div class="container">
      <p class="eyebrow">{sections.curriculum?.eyebrow}</p>
      <h2>{sections.curriculum?.heading}</h2>
      <p class="section-intro">{sections.curriculum?.description}</p>

      <div class="grid g4">
        {(cards.curriculum ?? []).map((card) => (
          <article class="curric">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <p class="eyebrow">{sections.pathways?.eyebrow}</p>
      <h2>{sections.pathways?.heading}</h2>
      <p class="section-intro">{sections.pathways?.description}</p>

      <div class="grid g2">
        {(cards.pathways ?? []).map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>

            {card.buttonText && (
              <a class="btn secondary" href={card.buttonLink}>
                {card.buttonText}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="container cta-panel">
      <p class="eyebrow">{sections.cta?.eyebrow}</p>
      <h2>{sections.cta?.heading}</h2>
      <p>{sections.cta?.description}</p>

      <div class="hero-actions">
        {buttons.cta?.primaryText && (
          <a class="btn primary" href={buttons.cta.primaryLink}>
            {buttons.cta.primaryText}
          </a>
        )}

        {buttons.cta?.secondaryText && (
          <a class="btn secondary" href={buttons.cta.secondaryLink}>
            {buttons.cta.secondaryText}
          </a>
        )}
      </div>
    </div>
  </section>

  <style is:inline>
    .resource-tools {
      display: grid;
      gap: 1rem;
      margin: 1.5rem 0;
      padding: 1.25rem;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.08);
    }

    .resource-tools label {
      display: grid;
      gap: 0.5rem;
      color: #061b31;
      font-weight: 900;
    }

    .resource-tools input,
    .resource-tools select {
      width: 100%;
      border: 1px solid rgba(201, 150, 82, 0.34);
      border-radius: 16px;
      padding: 0.9rem 1rem;
      font: inherit;
      color: #061b31;
      background: #ffffff;
    }

    .resource-tools input:focus,
    .resource-tools select:focus {
      outline: 3px solid rgba(211, 155, 69, 0.18);
      border-color: #d39b45;
    }

    .resource-filter-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .resource-count {
      width: fit-content;
      margin: 0 0 1.2rem;
      padding: 0.65rem 0.9rem;
      border-radius: 999px;
      background: #061b31;
      color: #ffffff;
      font-weight: 900;
      font-size: 0.9rem;
    }

    .resource-card {
      overflow: hidden;
      min-height: 310px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .resource-card h3 {
      max-width: 100%;
      overflow-wrap: anywhere;
      word-break: normal;
      hyphens: auto;
      line-height: 1.08;
    }

    .resource-card p {
      overflow-wrap: anywhere;
    }

    .resource-category {
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .resource-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1rem 0;
    }

    .resource-meta span {
      display: inline-flex;
      max-width: 100%;
      padding: 0.42rem 0.7rem;
      border-radius: 999px;
      background: rgba(211, 155, 69, 0.12);
      color: #061b31;
      font-size: 0.82rem;
      font-weight: 900;
      overflow-wrap: anywhere;
    }

    .resource-meta .difficulty-badge {
      background: rgba(6, 27, 49, 0.08);
    }

    .resource-button {
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }

    .resource-button.unavailable {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .resource-empty {
      margin-top: 1rem;
    }

    @media (max-width: 980px) {
      .resource-filter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .resource-filter-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const searchInput = document.getElementById("resource-search");
    const categoryFilter = document.getElementById("resource-category-filter");
    const typeFilter = document.getElementById("resource-type-filter");
    const skillFilter = document.getElementById("resource-skill-filter");
    const difficultyFilter = document.getElementById("resource-difficulty-filter");
    const resourceCards = Array.from(document.querySelectorAll("[data-resource-card]"));
    const resourceCount = document.getElementById("resource-count");
    const emptyState = document.getElementById("resource-empty");

    function normalise(value) {
      return String(value || "").toLowerCase().trim();
    }

    function matchesFilter(value, filterValue) {
      if (!filterValue || filterValue === "all") {
        return true;
      }

      return normalise(value) === normalise(filterValue);
    }

    function getSearchBlob(card) {
      return normalise(
        [
          card.dataset.title,
          card.dataset.description,
          card.dataset.category,
          card.dataset.type,
          card.dataset.skill,
          card.dataset.difficulty,
        ].join(" ")
      );
    }

    function updateResources() {
      const searchTerm = normalise(searchInput?.value);
      const selectedCategory = categoryFilter?.value || "all";
      const selectedType = typeFilter?.value || "all";
      const selectedSkill = skillFilter?.value || "all";
      const selectedDifficulty = difficultyFilter?.value || "all";

      let visibleCount = 0;

      resourceCards.forEach((card) => {
        const searchMatches = !searchTerm || getSearchBlob(card).includes(searchTerm);
        const categoryMatches = matchesFilter(card.dataset.category, selectedCategory);
        const typeMatches = matchesFilter(card.dataset.type, selectedType);
        const skillMatches = matchesFilter(card.dataset.skill, selectedSkill);
        const difficultyMatches = matchesFilter(card.dataset.difficulty, selectedDifficulty);

        const isVisible =
          searchMatches &&
          categoryMatches &&
          typeMatches &&
          skillMatches &&
          difficultyMatches;

        card.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (resourceCount) {
        resourceCount.textContent = `${visibleCount} resource${visibleCount === 1 ? "" : "s"} shown.`;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }
    }

    [searchInput, categoryFilter, typeFilter, skillFilter, difficultyFilter].forEach((control) => {
      if (control) {
        control.addEventListener("input", updateResources);
        control.addEventListener("change", updateResources);
      }
    });

    updateResources();
  </script>
</BaseLayout>
