---
import { getCollection } from "astro:content";
import Dashboard from "../components/Dashboard.astro";
import { legacyResources } from "../content/config";

// Load studio resources
const studioResources = await getCollection("resources");

// Merge legacy + studio
const allResources = [...legacyResources, ...studioResources];

// Filters / search / view toggle logic
let filterCategory = Astro.request.query.get("category") || "all";
let filterType = Astro.request.query.get("type") || "all";
let viewMode = Astro.request.query.get("view") || "folders";

// Map resources by category group (Legal Practice / Professional Skills)
const resourceMap = allResources.reduce((acc, res) => {
  const categoryGroup = res.categoryGroup || "Uncategorized";
  if (!acc[categoryGroup]) acc[categoryGroup] = [];
  acc[categoryGroup].push(res);
  return acc;
}, {});

function getResourceKey(res) {
  return res.packCode || res.slug || res.title || "unknown";
}

function getCoachLink(res) {
  return `/ai-skills-coach?pack=${res.packCode}`;
}

function filteredResources(resources) {
  return resources.filter((res) => {
    let categoryMatch = filterCategory === "all" || res.categoryGroup === filterCategory;
    let typeMatch = filterType === "all" || res.sheetType === filterType;
    return categoryMatch && typeMatch;
  });
}
---

<!-- Page Header / Navbar is preserved -->
<main class="resources-page">
  <!-- Hero section already exists -->
  <section class="hero">
    <h1>Resources</h1>
    <p>Explore Student and Tutor Sheets for Legal & Professional Skills.</p>
  </section>

  <!-- Dashboard section -->
  <section class="dashboard-section">
    <Dashboard />
  </section>

  <!-- AI Skills Coach banner -->
  <section class="ai-coach-banner">
    <a href="/ai-skills-coach" class="btn btn-gold">Ask AI Skills Coach</a>
  </section>

  <!-- Search / Filter / View Toggle -->
  <section class="filter-bar">
    <form method="get">
      <select name="category" onchange="this.form.submit()">
        <option value="all">All Categories</option>
        <option value="Legal Practice Skills" selected={filterCategory==='Legal Practice Skills'}>Legal Practice Skills</option>
        <option value="Professional Skills" selected={filterCategory==='Professional Skills'}>Professional Skills</option>
      </select>

      <select name="type" onchange="this.form.submit()">
        <option value="all">All Types</option>
        <option value="student" selected={filterType==='student'}>Student Sheets</option>
        <option value="tutor" selected={filterType==='tutor'}>Tutor Sheets</option>
      </select>

      <select name="view" onchange="this.form.submit()">
        <option value="folders" selected={viewMode==='folders'}>View as Folders</option>
        <option value="list" selected={viewMode==='list'}>View as List</option>
      </select>
    </form>
  </section>

  <!-- Resource Library -->
  <section class="resource-library">
    {Object.entries(resourceMap).map(([categoryGroup, resources]) => {
      const filtered = filteredResources(resources);
      if (!filtered.length) return null;

      return (
        <div class="category-group" key={categoryGroup}>
          <h2>{categoryGroup}</h2>
          <div class={viewMode==='folders' ? 'folder-view' : 'list-view'}>
            {filtered.map((res) => (
              <div class="resource-card" key={getResourceKey(res)}>
                <h3>{res.title}</h3>
                <p>Skill: {res.skill}</p>
                <p>Type: {res.sheetType}</p>
                <p>Difficulty: {res.difficulty || 'N/A'}</p>
                <p>Category: {res.categoryGroup}</p>

                <div class="buttons">
                  {res.sheetType === 'student' && res.studentLink && (
                    <>
                      <a href={res.studentLink} target="_blank" class="btn btn-primary">Open Student Sheet</a>
                      <a href={`/answer-pack?pack=${res.packCode}`} class="btn btn-gold">Answer Pack</a>
                    </>
                  )}

                  {res.sheetType === 'tutor' && res.tutorLink && (
                    <a href={res.tutorLink} target="_blank" class="btn btn-secondary">Open Tutor Sheet</a>
                  )}

                  <a href={getCoachLink(res)} class="btn btn-outline">Ask AI Skills Coach</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </section>

  <!-- Disclaimer -->
  <section class="disclaimer">
    <small>
      LawBridge resources are provided for educational and training purposes only.
      They do not constitute legal advice and are not intended as guidance for any particular jurisdiction,
      legal system, regulator, court, firm policy or client matter.
      Students should always check the applicable law, rules and professional requirements in the relevant jurisdiction.
    </small>
  </section>
</main>

<style>
.resources-page { padding: 2rem; font-family: Georgia, serif; }
.hero { text-align: center; margin-bottom: 2rem; }
.dashboard-section { margin-bottom: 2rem; }
.ai-coach-banner { text-align: center; margin-bottom: 1.5rem; }
.filter-bar { display: flex; gap: 1rem; justify-content: center; margin-bottom: 2rem; }
.resource-library { display: flex; flex-direction: column; gap: 2rem; }
.category-group h2 { font-size: 1.75rem; margin-bottom: 1rem; }
.folder-view { display: flex; flex-wrap: wrap; gap: 1rem; }
.list-view { display: flex; flex-direction: column; gap: 1rem; }
.resource-card { background: #fff; border-radius: 8px; padding: 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); width: 250px; }
.resource-card h3 { margin-top: 0; }
.resource-card .buttons { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; }
.btn { padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; text-align: center; display: inline-block; }
.btn-primary { background-color: #061b31; color: #fff; }
.btn-secondary { background-color: #d39b45; color: #fff; }
.btn-gold { background-color: #e7b65f; color: #061b31; }
.btn-outline { border: 1px solid #061b31; color: #061b31; background: transparent; }
.disclaimer { margin-top: 3rem; text-align: center; font-size: 0.8rem; color: #555; }
</style>
