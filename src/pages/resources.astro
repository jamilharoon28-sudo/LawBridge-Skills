---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allResources = await getCollection("resources");

// Organise resources by category and type
const categories = ["legal-practice-skills", "professional-skills"];
const types = ["student", "tutor"];

function filterResources(category, type) {
  return allResources.filter(
    (res) => res.data.category === category && res.data.type === type
  );
}
---

<BaseLayout title="Resources | LawBridge">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">LawBridge Resources</p>
        <h1>Practical Legal Skills Simulations</h1>
        <p>Explore Student Packs, Tutor Guides, and AI-assisted simulations organised by skill area.</p>
      </div>
    </div>
  </section>

  <!-- Dashboard component included at top -->
  <Dashboard />

  {categories.map((category) => (
    <section class="section">
      <div class="container">
        <h2 class="section-heading">{category.replace("-", " ")}</h2>

        {types.map((type) => {
          const packs = filterResources(category, type);
          return (
            <div class="resource-subsection">
              <h3>{type === "student" ? "Student Packs" : "Tutor Guides"}</h3>
              {packs.length > 0 ? (
                <div class="grid g3">
                  {packs.map((pack) => (
                    <article class="card">
                      <h4>{pack.data.title}</h4>
                      <p>{pack.data.skill} | {pack.data.difficulty || "N/A"}</p>

                      {pack.data.studentLink && type === "student" && (
                        <a href={pack.data.studentLink} target="_blank">Open Student Pack</a>
                      )}

                      {pack.data.tutorLink && type === "tutor" && (
                        <a href={pack.data.tutorLink} target="_blank">Open Tutor Guide</a>
                      )}

                      <a href={`/ai-skills-coach?pack=${encodeURIComponent(pack.data.code)}`} target="_blank">AI Skills Coach</a>
                    </article>
                  ))}
                </div>
              ) : (
                <p>No packs available in this section.</p>
              )}
            </div>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>

<style is:inline>
.section-heading {
  font-size: 2rem;
  margin-bottom: 1rem;
  color: #061b31;
}

.resource-subsection {
  margin-bottom: 2rem;
}

.resource-subsection h3 {
  font-size: 1.4rem;
  margin-bottom: 0.8rem;
  color: #142033;
}

.card {
  padding: 1.2rem;
  border-radius: 20px;
  background: rgba(255,255,255,0.9);
  border: 1px solid rgba(6,27,49,0.1);
  box-shadow: 0 10px 40px rgba(6,27,49,0.06);
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.card h4 {
  margin: 0;
  font-size: 1.2rem;
  color: #061b31;
}

.card p {
  margin: 0;
  font-size: 0.95rem;
  color: #334155;
}

.card a {
  text-decoration: none;
  color: #d39b45;
  font-weight: 700;
}
</style>
