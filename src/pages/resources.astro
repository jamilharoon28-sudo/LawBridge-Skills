---
import BaseLayout from "../layouts/BaseLayout.astro";
import Dashboard from "../components/Dashboard.astro";
import { getCollection } from "astro:content";

const resources = await getCollection("resources");

function normaliseText(value, fallback = "") {
  return String(value || fallback).trim();
}

function slugify(value) {
  return String(value || "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function getCategoryGroup(resource) {
  return (
    resource.data.categoryGroup ||
    resource.data.category ||
    "Legal Practice Skills"
  );
}

function getSkill(resource) {
  return resource.data.skill || "General Skills";
}

function getSheetType(resource) {
  const rawType = String(resource.data.sheetType || resource.data.type || "student").toLowerCase();

  if (rawType.includes("tutor")) {
    return "tutor";
  }

  return "student";
}

function getPackCode(resource) {
  return resource.data.code || resource.slug || "";
}

function getPackTitle(resource) {
  return (
    resource.data.scenario ||
    resource.data.title ||
    "LawBridge simulation pack"
  );
}

function getStudentLink(resource) {
  return resource.data.studentLink || resource.data.downloadLink || resource.data.link || "";
}

function getTutorLink(resource) {
  return resource.data.tutorLink || "";
}

const groupedResources = resources.reduce((map, resource) => {
  const categoryGroup = getCategoryGroup(resource);
  const skill = getSkill(resource);
  const sheetType = getSheetType(resource);

  if (!map.has(categoryGroup)) {
    map.set(categoryGroup, new Map());
  }

  if (!map.get(categoryGroup).has(skill)) {
    map.get(categoryGroup).set(skill, new Map());
  }

  if (!map.get(categoryGroup).get(skill).has(sheetType)) {
    map.get(categoryGroup).get(skill).set(sheetType, []);
  }

  map.get(categoryGroup).get(skill).get(sheetType).push(resource);
  return map;
}, new Map());

const orderedCategories = [
  "Legal Practice Skills",
  "Professional Skills",
];

const categoryEntries = [
  ...orderedCategories
    .filter((category) => groupedResources.has(category))
    .map((category) => [category, groupedResources.get(category)]),
  ...Array.from(groupedResources.entries()).filter(
    ([category]) => !orderedCategories.includes(category)
  ),
];

const sheetTypeLabels = {
  student: "Student Packs",
  tutor: "Tutor Guides",
};

const orderedSheetTypes = ["student", "tutor"];
---

<BaseLayout title="Resources | LawBridge">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">LawBridge Resources</p>
        <h1>Practical Legal Skills Simulations</h1>
        <p>
          Explore Student Packs, Tutor Guides and AI-supported practical skills simulations organised by skill area.
        </p>
      </div>
    </div>
  </section>

  <Dashboard />

  <section class="section resource-intro-section">
    <div class="container">
      <div class="resource-intro-card">
        <p class="eyebrow">AI-supported learning</p>
        <h2>Work through practical packs with structured guidance.</h2>
        <p>
          Use the Student Packs to practise realistic legal and professional skills tasks, then use the AI Skills Coach for educational feedback and next-step guidance.
        </p>
        <a class="primary-link" href="/ai-skills-coach">Open AI Skills Coach</a>
      </div>
    </div>
  </section>

  <section class="section resource-library-section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Resource Library</p>
          <h2>All simulation packs</h2>
        </div>
      </div>

      {categoryEntries.length > 0 ? (
        categoryEntries.map(([categoryGroup, skillMap]) => (
          <details class="category-block" open>
            <summary class="category-summary">
              <span>{categoryGroup}</span>
              <small>{Array.from(skillMap.keys()).length} topics</small>
            </summary>

            <div class="skill-dropdown-list">
              {Array.from(skillMap.entries()).map(([skill, sheetTypeMap]) => (
                <details class="skill-block">
                  <summary class="skill-summary">
                    <span>{skill}</span>
                    <small>
                      {Array.from(sheetTypeMap.values()).flat().length} resources
                    </small>
                  </summary>

                  <div class="sheet-type-list">
                    {orderedSheetTypes
                      .filter((sheetType) => sheetTypeMap.has(sheetType))
                      .map((sheetType) => {
                        const sheetResources = sheetTypeMap.get(sheetType) || [];

                        return (
                          <details class="sheet-type-block" open={sheetType === "student"}>
                            <summary class="sheet-type-summary">
                              <span>{sheetTypeLabels[sheetType] || sheetType}</span>
                              <small>{sheetResources.length} files</small>
                            </summary>

                            <div class="resource-grid">
                              {sheetResources.map((resource) => {
                                const packCode = getPackCode(resource);
                                const title = getPackTitle(resource);
                                const resourceSkill = normaliseText(resource.data.skill, "Practical Skills");
                                const difficulty = normaliseText(resource.data.difficulty, "Intermediate");
                                const studentLink = getStudentLink(resource);
                                const tutorLink = getTutorLink(resource);
                                const isStudent = sheetType === "student";

                                return (
                                  <article
                                    class={`resource-card ${isStudent ? "" : "tutor-card"}`}
                                    data-category={slugify(categoryGroup)}
                                    data-type={sheetType}
                                    data-skill={slugify(resourceSkill)}
                                  >
                                    <div>
                                      <span class="pack-code">{packCode || "PACK"}</span>
                                      <h5>{title}</h5>
                                      <p>{resourceSkill}</p>
                                      <small>{difficulty}</small>
                                    </div>

                                    <div class="resource-actions">
                                      {isStudent && studentLink && (
                                        <a class="resource-button secondary" href={studentLink} target="_blank">
                                          Open Student Sheet
                                        </a>
                                      )}

                                      {!isStudent && tutorLink && (
                                        <a class="resource-button secondary" href={tutorLink} target="_blank">
                                          Open Tutor Guide
                                        </a>
                                      )}

                                      {isStudent && packCode && (
                                        <a class="resource-button primary" href={`/answer-pack?pack=${encodeURIComponent(packCode)}`}>
                                          Answer Pack
                                        </a>
                                      )}

                                      <a
                                        class="resource-button ghost"
                                        href={`/ai-skills-coach?pack=${encodeURIComponent(packCode)}&scenario=${encodeURIComponent(title)}&skill=${encodeURIComponent(resourceSkill)}`}
                                      >
                                        Ask AI Skills Coach
                                      </a>
                                    </div>
                                  </article>
                                );
                              })}
                            </div>
                          </details>
                        );
                      })}
                  </div>
                </details>
              ))}
            </div>
          </details>
        ))
      ) : (
        <p class="empty-message">No resources are available yet.</p>
      )}
    </div>
  </section>

  <section class="section disclaimer-section">
    <div class="container">
      <p>
        LawBridge resources are provided for educational and training purposes only. They do not constitute legal advice and are not intended as guidance for any particular jurisdiction, legal system, regulator, court, firm policy or client matter. Students should always check the applicable law, rules and professional requirements in the relevant jurisdiction.
      </p>
    </div>
  </section>
</BaseLayout>

<style is:inline>
  .resource-intro-section {
    padding-top: 2rem;
  }

  .resource-intro-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 28px;
    background: #061b31;
    color: #ffffff;
    box-shadow: 0 24px 70px rgba(6, 27, 49, 0.14);
  }

  .resource-intro-card h2 {
    margin: 0;
    max-width: 850px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .resource-intro-card p:not(.eyebrow) {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.7;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 0.7rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #e7b65f, #d39b45);
    color: #061b31;
    text-decoration: none;
    font-weight: 900;
  }

  .section-heading-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .section-heading-row h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.4rem);
    color: #061b31;
    letter-spacing: -0.04em;
  }

  .category-block {
    margin-top: 2rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(201, 150, 82, 0.24);
  }

  .category-block h3 {
    margin: 0 0 1.2rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: #061b31;
  }

  .category-summary,
  .skill-summary,
  .sheet-type-summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .category-summary::-webkit-details-marker,
  .skill-summary::-webkit-details-marker,
  .sheet-type-summary::-webkit-details-marker {
    display: none;
  }

  .category-summary {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: #061b31;
    font-weight: 900;
  }

  .category-summary::before,
  .skill-summary::before,
  .sheet-type-summary::before {
    content: "▸";
    display: inline-flex;
    margin-right: 0.55rem;
    color: #b37b32;
    transition: transform 0.2s ease;
  }

  .category-block[open] > .category-summary::before,
  .skill-block[open] > .skill-summary::before,
  .sheet-type-block[open] > .sheet-type-summary::before {
    transform: rotate(90deg);
  }

  .category-summary span,
  .skill-summary span,
  .sheet-type-summary span {
    flex: 1;
  }

  .category-summary small,
  .skill-summary small,
  .sheet-type-summary small {
    font-family: inherit;
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 900;
  }

  .skill-dropdown-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .skill-block {
    padding: 1rem;
    border-radius: 24px;
    background: rgba(248, 241, 228, 0.74);
    border: 1px solid rgba(201, 150, 82, 0.22);
  }

  .skill-summary {
    color: #061b31;
    font-weight: 900;
    font-size: 1.15rem;
  }

  .sheet-type-list {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
  }

  .sheet-type-block {
    padding: 0.9rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(201, 150, 82, 0.2);
  }

  .sheet-type-summary {
    color: #8a5a18;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 900;
  }

  .resource-subsection {
    margin-top: 1.4rem;
  }

  .resource-subsection h4 {
    margin: 0 0 0.9rem;
    color: #8a5a18;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 900;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .resource-card {
    min-height: 250px;
    padding: 1.2rem;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(201, 150, 82, 0.26);
    box-shadow: 0 18px 52px rgba(6, 27, 49, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .tutor-card {
    background: rgba(248, 241, 228, 0.72);
  }

  .pack-code {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 0.75rem;
    padding: 0.42rem 0.7rem;
    border-radius: 999px;
    background: rgba(211, 155, 69, 0.14);
    color: #8a5a18;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .resource-card h5 {
    margin: 0 0 0.55rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    line-height: 1.12;
    color: #061b31;
    letter-spacing: -0.02em;
  }

  .resource-card p {
    margin: 0;
    color: #334155;
    font-weight: 800;
    line-height: 1.5;
  }

  .resource-card small {
    display: inline-block;
    margin-top: 0.55rem;
    color: #64748b;
    font-weight: 800;
  }

  .resource-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .resource-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.65rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
    font-size: 0.9rem;
  }

  .resource-button.primary {
    background: linear-gradient(135deg, #e7b65f, #d39b45);
    color: #061b31;
  }

  .resource-button.secondary {
    background: #061b31;
    color: #ffffff;
  }

  .resource-button.ghost {
    background: #ffffff;
    color: #061b31;
    border: 1px solid rgba(201, 150, 82, 0.32);
  }

  .empty-message {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    font-weight: 700;
  }

  .disclaimer-section {
    padding-top: 0;
  }

  .disclaimer-section p {
    margin: 0;
    padding: 1rem 1.2rem;
    border-radius: 18px;
    background: rgba(6, 27, 49, 0.05);
    color: #475569;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 1100px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
