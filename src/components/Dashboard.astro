---
import { getCollection } from "astro:content";

const resources = await getCollection("resources");

const packs = resources
  .map((entry) => ({
    code: entry.data.code || "",
    title: entry.data.scenario || entry.data.title || "Untitled Pack",
    skill: entry.data.skill || "Practical Skills",
    difficulty: entry.data.difficulty || "Intermediate",
  }))
  .filter((pack) => pack.code || pack.title);
---

<section class="dashboard-shell">
  <div class="container">
    <header class="dashboard-hero">
      <div>
        <p class="dashboard-eyebrow">LawBridge Student Dashboard</p>
        <h1>Your practical skills progress.</h1>
        <p>
          Track your LawBridge simulation progress, continue packs and see your next recommended task.
        </p>
      </div>

      <aside class="recommendation-card">
        <p class="dashboard-eyebrow">Recommended next</p>
        <h2 id="next-pack-title">Loading recommendation...</h2>
        <p id="next-pack-detail">Checking your current progress.</p>
        <a id="next-pack-link" class="dashboard-button primary" href="/ai-skills-coach">
          Continue with AI Coach
        </a>
      </aside>
    </header>

    <section class="dashboard-section">
      <div class="dashboard-section-heading">
        <div>
          <p class="dashboard-eyebrow">Pack Progress</p>
          <h2>All simulations</h2>
        </div>

        <button id="refresh-progress" class="dashboard-button secondary" type="button">
          Refresh Progress
        </button>
      </div>

      <div class="progress-grid" id="progress-grid">
        {packs.map((pack) => (
          <article
            class="progress-card"
            data-pack-code={pack.code}
            data-pack-title={pack.title}
            data-pack-skill={pack.skill}
          >
            <div>
              <span class="pack-code">{pack.code || "PACK"}</span>
              <h3>{pack.title}</h3>
              <p>{pack.skill}</p>
              <small>{pack.difficulty}</small>
            </div>

            <div class="progress-actions">
              <span class="status-pill not-started" data-status-for={pack.code}>
                Not started
              </span>

              <a
                class="dashboard-button secondary open-pack-link"
                href={`/ai-skills-coach?pack=${encodeURIComponent(pack.code)}&scenario=${encodeURIComponent(pack.title)}&skill=${encodeURIComponent(pack.skill)}`}
                data-pack-code={pack.code}
                data-pack-title={pack.title}
                data-pack-skill={pack.skill}
              >
                Open Pack
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <style is:inline>
    .dashboard-shell {
      padding: 3rem 0;
      background:
        radial-gradient(circle at top right, rgba(231, 182, 95, 0.16), transparent 32%),
        linear-gradient(180deg, #f8f1e4 0%, #fbf7ef 100%);
      color: #061b31;
    }

    .dashboard-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0.7rem 1rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      border: 0;
      cursor: pointer;
      font: inherit;
    }

    .dashboard-button.primary {
      background: linear-gradient(135deg, #e7b65f, #d39b45);
      color: #061b31;
      box-shadow: 0 12px 28px rgba(211, 155, 69, 0.22);
    }

    .dashboard-button.secondary {
      background: #ffffff;
      color: #061b31;
      border: 1px solid rgba(201, 150, 82, 0.32);
    }

    .dashboard-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.85fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: clamp(1.5rem, 4vw, 3rem);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(201, 150, 82, 0.3);
      box-shadow: 0 28px 90px rgba(6, 27, 49, 0.12);
    }

    .dashboard-eyebrow {
      margin: 0 0 0.7rem;
      color: #b37b32;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
    }

    .dashboard-hero h1 {
      max-width: 920px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.8rem, 6vw, 5.6rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #061b31;
    }

    .dashboard-hero p:not(.dashboard-eyebrow),
    .progress-card p,
    .recommendation-card p {
      color: #334155;
      line-height: 1.65;
    }

    .dashboard-hero > div > p:not(.dashboard-eyebrow) {
      max-width: 760px;
      margin: 1rem 0 0;
      font-size: 1.08rem;
    }

    .recommendation-card {
      padding: 1.3rem;
      border-radius: 24px;
      background: #061b31;
      color: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .recommendation-card h2 {
      margin: 0;
      color: #ffffff;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.8rem;
      line-height: 1.1;
    }

    .recommendation-card p {
      color: rgba(255, 255, 255, 0.82);
    }

    .dashboard-section {
      margin-top: 2rem;
    }

    .dashboard-section-heading {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: end;
      margin-bottom: 1rem;
    }

    .dashboard-section-heading h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 3vw, 3rem);
      color: #061b31;
    }

    .progress-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .progress-card {
      min-height: 230px;
      padding: 1.25rem;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(201, 150, 82, 0.28);
      box-shadow: 0 18px 52px rgba(6, 27, 49, 0.09);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
    }

    .pack-code {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      margin-bottom: 0.75rem;
      padding: 0.42rem 0.7rem;
      border-radius: 999px;
      background: rgba(211, 155, 69, 0.14);
      color: #8a5a18;
      font-size: 0.72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .progress-card h3 {
      margin: 0 0 0.45rem;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.45rem;
      color: #061b31;
      letter-spacing: -0.02em;
    }

    .progress-card p {
      margin: 0;
      font-weight: 800;
    }

    .progress-card small {
      display: inline-block;
      margin-top: 0.55rem;
      color: #64748b;
      font-weight: 800;
    }

    .progress-actions {
      display: flex;
      gap: 0.7rem;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      font-weight: 900;
      font-size: 0.84rem;
    }

    .status-pill.not-started {
      background: #e5e7eb;
      color: #374151;
    }

    .status-pill.in-progress {
      background: rgba(211, 155, 69, 0.18);
      color: #8a5a18;
    }

    .status-pill.completed {
      background: rgba(22, 163, 74, 0.14);
      color: #166534;
    }

    .status-pill.needs-feedback {
      background: rgba(220, 38, 38, 0.12);
      color: #991b1b;
    }

    @media (max-width: 1100px) {
      .dashboard-hero,
      .progress-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline>
    const progressCards = document.querySelectorAll(".progress-card");
    const openPackLinks = document.querySelectorAll(".open-pack-link");
    const refreshButton = document.getElementById("refresh-progress");
    const nextPackTitle = document.getElementById("next-pack-title");
    const nextPackDetail = document.getElementById("next-pack-detail");
    const nextPackLink = document.getElementById("next-pack-link");

    function getStudentId() {
      const existing = localStorage.getItem("lawbridgeStudentId");

      if (existing) {
        return existing;
      }

      const created = `student-${Date.now()}-${Math.random().toString(16).slice(2)}`;
      localStorage.setItem("lawbridgeStudentId", created);
      return created;
    }

    function normaliseStatusClass(status) {
      return String(status || "Not started")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function applyProgress(progress) {
      const packs = progress?.packs || {};

      progressCards.forEach((card) => {
        const code = card.dataset.packCode;
        const statusElement = card.querySelector("[data-status-for]");
        const saved = packs[code];

        const status = saved?.status || "Not started";
        const className = normaliseStatusClass(status);

        statusElement.textContent = status;
        statusElement.className = `status-pill ${className}`;
      });
    }

    async function loadProgress() {
      try {
        const response = await fetch("/.netlify/functions/load-progress", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            studentId: getStudentId(),
          }),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          applyProgress(result.progress || {});
        }
      } catch (error) {
        console.warn("Could not load progress:", error);
      }
    }

    async function saveOpenedProgress(link) {
      const packCode = link.dataset.packCode;
      const packTitle = link.dataset.packTitle;
      const skill = link.dataset.packSkill;

      if (!packCode) {
        return;
      }

      await fetch("/.netlify/functions/save-progress", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          studentId: getStudentId(),
          packCode,
          packTitle,
          skill,
          mode: "Opened from resources dashboard",
          status: "In progress",
        }),
      });
    }

    async function loadNextPack() {
      try {
        const response = await fetch("/.netlify/functions/next-pack", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            studentId: getStudentId(),
          }),
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.nextPack) {
          return;
        }

        const pack = result.nextPack;

        if (nextPackTitle) {
          nextPackTitle.textContent = pack.title || pack.code || "Recommended pack";
        }

        if (nextPackDetail) {
          nextPackDetail.textContent = pack.code
            ? `Continue with ${pack.code}.`
            : "Continue with your next available LawBridge simulation.";
        }

        if (nextPackLink) {
          const code = encodeURIComponent(pack.code || "");
          const title = encodeURIComponent(pack.title || "");
          const skill = encodeURIComponent(pack.skill || "");

          nextPackLink.href = `/ai-skills-coach?pack=${code}&scenario=${title}&skill=${skill}`;
        }
      } catch (error) {
        console.warn("Could not load next pack:", error);
      }
    }

    openPackLinks.forEach((link) => {
      link.addEventListener("click", async (event) => {
        event.preventDefault();

        try {
          await saveOpenedProgress(link);
        } catch (error) {
          console.warn("Could not save opened progress:", error);
        }

        window.location.href = link.href;
      });
    });

    refreshButton?.addEventListener("click", async () => {
      await loadProgress();
      await loadNextPack();
    });

    loadProgress();
    loadNextPack();
  </script>
</section>
